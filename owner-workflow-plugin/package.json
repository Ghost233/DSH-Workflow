{
  "name": "dsh-owner-workflow",
  "version": "0.1.0",
  "description": "面向 DeepSeek Harness 的 Owner 工作流编排插件",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./acceptance-runner": "./src/acceptance-runner.mjs",
    "./client": "./client.js",
    "./dashboard": "./dashboard-host.mjs",
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "files": [
    "index.js",
    "client.js",
    "dashboard-host.mjs",
    "scripts/",
    "src/",
    "vendor/dsh-approve-for-me/src/core/",
    "vendor/dsh-approve-for-me/LICENSE",
    "cordis.patch.yml",
    "THIRD_PARTY_NOTICES.md",
    "README.md",
    "README.zh.md",
    "kernel-presets/"
  ],
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build:client": "node scripts/build-client.mjs",
    "check:client": "node scripts/build-client.mjs --check",
    "test": "node ../scripts/run-workflow-tests.mjs",
    "test:dashboard": "node --test test/dashboard.test.mjs"
  },
  "dependencies": {
    "fs-ext": "2.1.1"
  }
}
