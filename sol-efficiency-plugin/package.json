{
  "name": "dsh-sol-efficiency",
  "version": "0.1.0",
  "description": "SoL-Pi action fusion and evidence-preserving log reduction for DeepSeek Harness",
  "type": "module",
  "main": "index.js",
  "exports": { ".": "./index.js", "./client": "./client.js", "./package.json": "./package.json", "./cordis.patch.yml": "./cordis.patch.yml" },
  "files": ["index.js", "client.js", "src/", "cordis.patch.yml", "README.md", "LICENSE", "THIRD_PARTY_NOTICES.md", "upstream.json"],
  "license": "MIT",
  "engines": { "node": ">=22.19.0" },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@deepseek-ai/dsh-settings": "0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.1-rc.2"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "inject": ["@deepseek-ai/dsh-client-runtime", "@deepseek-ai/dsh-client-ui-settings", "@deepseek-ai/dsh-client-ui-settings-plugins"],
      "platform": "web"
    }
  },
  "scripts": {
    "test": "node --import ./test/workspace-loader.mjs --test test/*.test.mjs",
    "check:upstream": "node scripts/check-upstream.mjs",
    "demo": "node --import ./test/workspace-loader.mjs scripts/demo.mjs"
  }
}
