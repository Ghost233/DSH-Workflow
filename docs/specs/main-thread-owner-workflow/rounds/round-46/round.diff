+
+test('T15 Supervisor reserved recovery slot cannot generate phantom Owner execution timeouts', async t => {
+  const f = await createRecoverySessionFixture(t, { executable: true })
+  const next = await supervisorControl(f, 'supervisor-next')
+  await supervisorControl(f, 'supervisor-ack', { actionId: next.actionId })
+  const before = await mutateRecoverySessionState(f, s => {
+    s.supervisorOutbox['T1:api'].status = 'launching'
+    s.supervisorOutbox['T1:api'].launchedAt = '2000-01-01T00:00:00.000Z'
+  })
+  assert.equal(before.tasks[0].status, 'pending')
+  let cursor = before.supervisorEventCursor
+  for (let i = 0; i < 2; i++) {
+    const observation = await supervisorControl(f, 'supervisor-await-event', { cursor, waitMs: 1 })
+    assert.equal(observation.kind, 'timeout')
+    assert.equal(observation.event.type, 'supervisor.wait-timeout')
+    cursor = observation.cursor
+  }
+  const after = await readRecoverySessionState(f)
+  assert.equal(after.tasks[0].status, 'pending')
+  assert.equal(after.supervisorTimeouts, undefined)
+  assert.deepEqual(after.ownerRuns, before.ownerRuns)
+  assert.deepEqual(after.recoveryAdmission, before.recoveryAdmission)
+  assert.equal(f.adapter.requests.length, 0)
+})
