+test('T15 idle timeout preserves the live Owner until actual termination, then recovery spends credit', { timeout: 30000 }, async t => {
+  const f = await createRecoverySessionFixture(t, { executable: true, includeIndependentOwner: true,
+    limits: { totalLimit: 1, problemLimit: 1 },
+    modelScript: m => [...completedModel(m), ...failedModel(m)] })
+  const release = Promise.withResolvers()
+  const aborted = Promise.withResolvers()
+  const originalStream = f.adapter.stream.bind(f.adapter)
+  let first = true
+  let dispatch
+  const within = async (promise, label) => {
+    let timer
+    try { return await Promise.race([promise, new Promise((_, reject) => {
+      timer = setTimeout(() => reject(new Error(`${label} exceeded finite observation`)), 15000)
+    })]) } finally { clearTimeout(timer) }
+  }
+  f.adapter.stream = async function* (options) {
+    if (!first) { yield* originalStream(options); return }
+    first = false
+    f.adapter.requests.push(options)
+    yield { type: 'block-start', index: 0, blockType: 'text' }
+    yield { type: 'text-delta', index: 0, text: 'controlled Owner work' }
+    assert.ok(options.signal)
+    await within(new Promise(resolve => {
+      const onAbort = () => { aborted.resolve(); resolve() }
+      if (options.signal.aborted) onAbort()
+      else options.signal.addEventListener('abort', onAbort, { once: true })
+    }), 'real abort signal')
+    await within(release.promise, 'transport release')
+    throw new Error('aborted')
+  }
+  try {
+    await mutateRecoverySessionState(f, s => { s.ownerRuns = {} })
+    const next = await supervisorControl(f, 'supervisor-next')
+    const ack = await supervisorControl(f, 'supervisor-ack', { actionId: next.actionId })
+    await supervisorControl(f, 'supervisor-execute', { reservationId: ack.reservations[0].reservationId })
+    dispatch = f.runtime.supervisorDispatches.get(`${f.workflowId}:T1:api`)
+    assert.ok(dispatch)
+    await within((async () => { while (f.adapter.requests.length === 0) await new Promise(resolve => setTimeout(resolve, 5)) })(), 'Owner start')
+    const before = await mutateRecoverySessionState(f, s => {
+      s.supervisorOutbox['T1:api'].launchedAt = '2000-01-01T00:00:00.000Z'
+      Object.assign(s.ownerRuns['T1:api'], { startedAt: '2000-01-01T00:00:00.000Z',
+        updatedAt: '2000-01-01T00:00:00.000Z', lastHeartbeatAt: '2000-01-01T00:00:00.000Z' })
+    })
+    const event = await supervisorControl(f, 'supervisor-await-event', { cursor: before.supervisorEventCursor, waitMs: 1 })
+    assert.equal(event.event.type, 'supervisor.owner-cancel-requested')
+    await within(aborted.promise, 'runtime cancellation delivery')
+    const held = await readRecoverySessionState(f)
+    assert.equal(held.tasks[0].status, 'running')
+    assert.deepEqual(held.ownerRuns['T1:api'], before.ownerRuns['T1:api'])
+    assert.equal(held.recoveryAdmission, undefined)
+    const child = f.ctx.agents.get(held.ownerRuns['T1:api'].sessionId)
+    assert.equal(child.session.events.some(item => item.type === 'turn/end'), false)
+    const active = f.runtime.activeOwners.get(child.id)
+    assert.equal((await f.runtime.assertOwnerLease(active.lease)).token, before.ownerRuns['T1:api'].leaseToken)
+    assert.equal((await supervisorControl(f, 'supervisor-next')).action, 'wait')
+    const again = await supervisorControl(f, 'supervisor-await-event', { cursor: event.cursor, waitMs: 1 })
+    assert.notEqual(again.event.type, 'supervisor.owner-cancel-requested')
+    const same = await readRecoverySessionState(f)
+    assert.deepEqual(same.supervisorTimeouts, held.supervisorTimeouts)
+    await mutateRecoverySessionState(f, s => { s.config.parallel = 2 })
+    await executeNextSupervisorTask(f, 'T2')
+    assert.equal(child.session.events.some(item => item.type === 'turn/end'), false)
+    release.resolve()
+    await within(dispatch, 'Owner failure settlement')
+    const failed = await readRecoverySessionState(f)
+    assert.equal(failed.ownerRuns['T1:api'].status, 'failed')
+    assert.equal(failed.tasks[0].status, 'pending')
+    assert.equal(failed.tasks[1].status, 'completed')
+    const persisted = await f.readFrom(child.id)
+    assert.equal(persisted.events.some(item => item.type === 'turn/end' && item.data.reason.kind === 'aborted'), true)
+    await executeNextSupervisorTask(f, 'T1')
+    const recovered = await readRecoverySessionState(f)
+    assert.equal(recovered.recoveryAdmission.budget.totalUsed, 1)
+    assert.equal(recovered.ownerRuns['T1:api'].recoverySession.phase, 'settled_failed')
+    assert.equal(recovered.ownerRuns['T1:api'].attempt, failed.ownerRuns['T1:api'].attempt + 1)
+    await executeNextSupervisorTask(f, 'T1')
+    assert.equal((await readRecoverySessionState(f)).tasks[0].status, 'stopped')
+    assert.equal(f.adapter.requests.length, 7)
+  } finally {
+    release.resolve()
+    if (dispatch) await within(dispatch, 'cleanup Owner settlement').catch(() => undefined)
+  }
+})
