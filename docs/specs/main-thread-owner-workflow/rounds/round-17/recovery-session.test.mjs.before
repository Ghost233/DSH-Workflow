import assert from 'node:assert/strict'
import { appendFile, readFile } from 'node:fs/promises'
import test from 'node:test'

import {
  RECOVERY_SESSION_REQUEST_CONTRACT,
  inspectRecoverySession,
} from '../src/recovery-session.mjs'
import {
  appendObservedPrompt,
  createRecoverySessionFixture,
  injectObservedPrompt,
  readRecoverySessionState,
  reserveRecoverySession,
} from './fixtures/recovery-session-fixture.mjs'

const content = 'recover the failed owner task'

function inspection(fixture, receipt) {
  return inspectRecoverySession({
    persistence: fixture.ctx.sessionPersistence,
    executionIdentity: receipt.executionIdentity,
    prompt: { id: receipt.executionIdentity.promptId, content },
  })
}

function request(receipt, prompt = { id: receipt.executionIdentity.promptId, content }) {
  return {
    contract: RECOVERY_SESSION_REQUEST_CONTRACT,
    taskId: 'T1',
    ownerId: 'api',
    requestId: receipt.requestId,
    prompt,
  }
}

test('T22 source-plane JSONL observes exactly one completed reserved prompt without writes', async t => {
  const fixture = await createRecoverySessionFixture(t)
  const receipt = await reserveRecoverySession(fixture)
  const observed = await appendObservedPrompt(fixture, receipt, content)
  const rawBefore = await fixture.readRaw(receipt.executionIdentity.sessionId)
  const eventsBefore = await fixture.readFrom(receipt.executionIdentity.sessionId)
  const requestsBefore = fixture.adapter.requests.length

  const result = await inspection(fixture, receipt)

  assert.equal(result.outcome, 'observed_terminal')
  assert.equal(result.phase, 'observed_terminal')
  assert.equal(result.turn, 1)
  assert.equal(result.step, 1)
  assert.equal(fixture.adapter.requests.length, requestsBefore)
  assert.deepEqual(await fixture.readRaw(receipt.executionIdentity.sessionId), rawBefore)
  assert.deepEqual(await fixture.readFrom(receipt.executionIdentity.sessionId), eventsBefore)
  assert.equal((await readRecoverySessionState(fixture)).ownerRuns['T1:api'].recoverySession, undefined)
  assert.match(observed.location.path, /session\.jsonl$/)
})

test('T22 source-plane JSONL distinguishes no artifact from one durable idle inbox prompt', async t => {
  const absent = await createRecoverySessionFixture(t)
  const absentReceipt = await reserveRecoverySession(absent)
  const absentRequests = absent.adapter.requests.length
  assert.deepEqual(await inspection(absent, absentReceipt), {
    outcome: 'paused', phase: 'technical_pause', reason: 'raw_artifact_missing',
  })
  assert.equal(absent.adapter.requests.length, absentRequests)

  const pending = await createRecoverySessionFixture(t)
  const pendingReceipt = await reserveRecoverySession(pending)
  await injectObservedPrompt(pending, pendingReceipt, content)
  const requestsBefore = pending.adapter.requests.length
  const result = await inspection(pending, pendingReceipt)
  assert.equal(result.outcome, 'pending')
  assert.equal(result.phase, 'durably_queued')
  assert.equal(pending.adapter.requests.length, requestsBefore)
})

test('T22 raw inspection pauses on duplicate input and malformed physical rows without re-sending', async t => {
  const duplicate = await createRecoverySessionFixture(t)
  const duplicateReceipt = await reserveRecoverySession(duplicate)
  const observed = await appendObservedPrompt(duplicate, duplicateReceipt, content)
  observed.agent.inject(duplicate.modules.freezeMessage({
    id: duplicateReceipt.executionIdentity.promptId,
    role: 'user',
    content: [{ type: 'text', text: content }],
    source: { kind: 'user' },
  }))
  await observed.agent.whenIdle()
  await duplicate.ctx.sessions.flush(observed.agent.session)
  const duplicateRequests = duplicate.adapter.requests.length
  const duplicateRaw = await duplicate.readRaw(duplicateReceipt.executionIdentity.sessionId)
  const duplicateResult = await inspection(duplicate, duplicateReceipt)
  assert.equal(duplicateResult.outcome, 'paused')
  assert.equal(duplicateResult.reason, 'prompt_not_unique')
  assert.equal(duplicate.adapter.requests.length, duplicateRequests)
  assert.deepEqual(await duplicate.readRaw(duplicateReceipt.executionIdentity.sessionId), duplicateRaw)

  const torn = await createRecoverySessionFixture(t)
  const tornReceipt = await reserveRecoverySession(torn)
  const tornObserved = await appendObservedPrompt(torn, tornReceipt, content)
  await appendFile(tornObserved.location.path, '{"type":"turn/end","seq":999}\n', 'utf8')
  const rawBefore = await readFile(tornObserved.location.path, 'utf8')
  const requestsBefore = torn.adapter.requests.length
  const tornResult = await inspection(torn, tornReceipt)
  assert.equal(tornResult.outcome, 'paused')
  assert.equal(torn.adapter.requests.length, requestsBefore)
  assert.equal(await readFile(tornObserved.location.path, 'utf8'), rawBefore)

  const truncated = await createRecoverySessionFixture(t)
  const truncatedReceipt = await reserveRecoverySession(truncated)
  const truncatedObserved = await appendObservedPrompt(truncated, truncatedReceipt, content)
  await appendFile(truncatedObserved.location.path, '{"type":"turn/end"', 'utf8')
  const truncatedRaw = await readFile(truncatedObserved.location.path, 'utf8')
  const truncatedRequests = truncated.adapter.requests.length
  const truncatedResult = await inspection(truncated, truncatedReceipt)
  assert.equal(truncatedResult.outcome, 'paused')
  assert.equal(truncated.adapter.requests.length, truncatedRequests)
  assert.equal(await readFile(truncatedObserved.location.path, 'utf8'), truncatedRaw)
})

test('T22 Runtime rejects wrong reservation binding and pauses the unready producer before session effects', async t => {
  const fixture = await createRecoverySessionFixture(t)
  const receipt = await reserveRecoverySession(fixture)
  const requestsBefore = fixture.adapter.requests.length

  const wrong = await fixture.runtime.reconcileRecoverySession(
    fixture.admissionAgent,
    fixture.workflowId,
    request(receipt, { id: `${receipt.executionIdentity.promptId}-wrong`, content }),
  )
  assert.equal(wrong.outcome, 'paused')
  assert.equal(wrong.reason, 'reservation_binding_mismatch')

  const current = await fixture.runtime.reconcileRecoverySession(
    fixture.admissionAgent,
    fixture.workflowId,
    request(receipt),
  )
  assert.equal(current.outcome, 'paused')
  // The minimal test root has no live Owner Registry.  A production-valid
  // root reaches owner_execution_adapter_not_ready after this same gate.
  assert.equal(current.reason, 'owner_start_not_authorized')
  assert.equal(fixture.adapter.requests.length, requestsBefore)
  assert.equal(await fixture.readRaw(receipt.executionIdentity.sessionId), undefined)
  const state = await readRecoverySessionState(fixture)
  assert.equal(state.ownerRuns['T1:api'].recoverySession, undefined)
  assert.equal(state.ownerSessions[receipt.executionIdentity.sessionId], undefined)
})

test('T22 refuses a real JSONL backend configured with compression before any read or retry', async t => {
  const fixture = await createRecoverySessionFixture(t, { compression: 'zstd' })
  const receipt = await reserveRecoverySession(fixture)
  const requestsBefore = fixture.adapter.requests.length
  const result = await inspection(fixture, receipt)
  assert.deepEqual(result, {
    outcome: 'paused', phase: 'technical_pause', reason: 'unsupported_persistence',
  })
  assert.equal(fixture.adapter.requests.length, requestsBefore)
})
