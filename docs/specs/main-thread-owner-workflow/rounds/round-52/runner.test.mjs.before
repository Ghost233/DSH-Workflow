    planningAgent: { phase: 'reviewing', recoveryAttempts: 0, updatedAt: '2020-01-01T00:00:00.000Z' },
  }, null, 2)}\n`, 'utf8')
  await writeFile(join(workspace, '.dsh-workflow', 'workflows', 'wf-recovery-exhausted.json'), `${JSON.stringify({
    contract: 'DSH_WORKFLOW_STATE_V1',
    id: 'wf-recovery-exhausted',
    root: workspace,
    status: 'planned',
    plan: { contract: 'DSH_PLAN_V2' },
    planDigest: 'plan-digest',
    planningAgent: {
      phase: 'failed', recoveryAttempts: 3, recoveryExhausted: true, updatedAt: '2020-01-01T00:00:00.000Z',
    },
  }, null, 2)}\n`, 'utf8')
  await writeFile(join(workspace, '.dsh-workflow', 'workflows', 'wf-review-failed-recoverable.json'), `${JSON.stringify({
    contract: 'DSH_WORKFLOW_STATE_V1',
    id: 'wf-review-failed-recoverable',
    root: workspace,
    status: 'planned',
    plan: { contract: 'DSH_PLAN_V2' },
    planDigest: 'plan-digest',
    planReview: { contract: 'DSH_PLAN_REVIEW_V1', status: 'needs_revision', summary: '仍需修订', issues: [] },
    planReviewRevisionCount: 1,
