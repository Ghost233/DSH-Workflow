    planReviewRevisionCount: 3,
    planRevisionLimit: 3,
    pendingPlanningDecision: {
      kind: 'plan_revision_extension', status: 'rejected', planDigest: 'rejected-plan-digest',
    },
    planningAgent: {
      phase: 'review_failed', revisionBudgetExhausted: true, updatedAt: new Date().toISOString(),
    },
  }, null, 2)}\n`, 'utf8')
  await writeFile(join(workspace, '.dsh-workflow', 'workflows', 'wf-revision-timeout-legacy.json'), `${JSON.stringify({
    contract: 'DSH_WORKFLOW_STATE_V1',
    id: 'wf-revision-timeout-legacy',
    root: workspace,
    status: 'planned',
    plan: { contract: 'DSH_PLAN_V2' },
    planDigest: 'plan-digest',
    planReview: { contract: 'DSH_PLAN_REVIEW_V1', status: 'needs_revision', summary: '仍需修订', issues: [] },
    planReviewDigest: 'plan-digest',
    planReviewRevisionCount: 1,
    planRevisionLimit: 3,
    planRevisionFailureCount: 3,
    planRevisionFailure: {
      at: '2020-01-01T00:00:00.000Z',
      error: 'planner 超过 180000ms 未完成，已停止本次规划阶段',
      count: 3,
      planDigest: 'plan-digest',
      planReviewDigest: 'plan-digest',
    },
    planningAgent: { phase: 'revision', recoveryAttempts: 1, updatedAt: '2020-01-01T00:00:00.000Z' },
  }, null, 2)}\n`, 'utf8')
  await writeFile(join(workspace, '.dsh-workflow', 'workflows', 'wf-intent-review-pending.json'), `${JSON.stringify({
    contract: 'DSH_WORKFLOW_STATE_V1',
    id: 'wf-intent-review-pending',
    root: workspace,
    status: 'failed',
    pendingPlanRevision: { number: 2, parent: 1, planDigest: 'intent-review-pending' },
    intentPlanRevisionCycle: { parent: 1, intentIds: ['intent-1'], attempts: 1, limit: 10 },
  }, null, 2)}\n`, 'utf8')
  await writeFile(join(workspace, '.dsh-workflow', 'workflows', 'wf-intent-rebuild.json'), `${JSON.stringify({
    contract: 'DSH_WORKFLOW_STATE_V1',
    id: 'wf-intent-rebuild',
    root: workspace,
    status: 'failed',
    pendingPlanRevision: {
      number: 2,
      parent: 1,
      planDigest: 'intent-rebuild',
      review: { contract: 'DSH_PLAN_REVIEW_V1', status: 'needs_revision', summary: '自动重建', issues: [] },
    },
    intentPlanRevisionCycle: { parent: 1, intentIds: ['intent-1'], attempts: 999, limit: 1 },
    planConvergence: {
      contract: 'DSH_WORKFLOW_CONVERGENCE_V1',
      nextStrategy: 'local_subgraph_rewrite',
    },
  }, null, 2)}\n`, 'utf8')
  await writeFile(join(workspace, '.dsh-workflow', 'workflows', 'wf-intent-rebuild-capped.json'), `${JSON.stringify({
    contract: 'DSH_WORKFLOW_STATE_V1',
    id: 'wf-intent-rebuild-capped',
    root: workspace,
    status: 'failed',
    pendingPlanRevision: {
      number: 2,
      parent: 1,
      planDigest: 'intent-rebuild-capped',
      review: { contract: 'DSH_PLAN_REVIEW_V1', status: 'needs_revision', summary: '达到上限', issues: [] },
    },
    intentPlanRevisionCycle: {
      runtimeVersion: 'owner-intent-v4', parent: 1, intentIds: ['intent-1'], attempts: 10, limit: 10,
    },
    planConvergence: {
      contract: 'DSH_WORKFLOW_CONVERGENCE_V1',
      nextStrategy: 'autonomous_incident',
    },
  }, null, 2)}\n`, 'utf8')
  await writeFile(join(workspace, '.dsh-workflow', 'workflows', 'wf-intent-rebuild-interrupted.json'), `${JSON.stringify({
    contract: 'DSH_WORKFLOW_STATE_V1',
    id: 'wf-intent-rebuild-interrupted',
    root: workspace,
    status: 'failed',
    intents: [{ id: 'intent-1', status: 'pending' }],
    intentPlanRevisionCycle: {
      parent: 1,
      intentIds: ['intent-1'],
      attempts: 2,
      limit: 10,
      phase: 'rebuild_pending',
    },
