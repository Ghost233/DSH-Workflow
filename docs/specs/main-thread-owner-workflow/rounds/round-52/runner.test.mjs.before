  await writeFile(join(workspace, '.dsh-workflow', 'workflows', 'wf-review-failed-exhausted.json'), `${JSON.stringify({
    contract: 'DSH_WORKFLOW_STATE_V1',
    id: 'wf-review-failed-exhausted',
