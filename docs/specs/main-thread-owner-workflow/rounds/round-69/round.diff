 export function candidateIndependentNext(state) { return prepare(state).receipt }

+export function candidateIndependentBinding(scope, task, reservationId) {
+  if (!scope.eligibleTaskIds.includes(task.taskId)) fail('任务不属于确认范围')
+  return { contract: 'DSH_CANDIDATE_INDEPENDENT_RESERVATION_V1',
+    source: scope.pauseSource, activePlanDigest: scope.activePlanDigest,
+    taskId: task.taskId, ownerId: task.ownerId, reservationId,
+    eligibleTaskIds: [...scope.eligibleTaskIds], scopeDigest: digest(scope) }
+}
+
+export function assertCandidateIndependentReservation(state, reservation) {
+  const binding = reservation?.candidatePause
+  const pause = activeCandidateRecoveryPause(state)
+  if (binding?.contract !== 'DSH_CANDIDATE_INDEPENDENT_RESERVATION_V1'
+    || !pause || binding.source !== pause.source || binding.activePlanDigest !== state.planDigest
+    || binding.reservationId !== reservation.reservationId || binding.taskId !== reservation.taskId
+    || binding.ownerId !== reservation.ownerId || !Array.isArray(binding.eligibleTaskIds)
+    || !binding.eligibleTaskIds.includes(binding.taskId)
+    || binding.scopeDigest !== digest({ kind: 'candidate_pause', pauseSource: binding.source,
+      activePlanDigest: binding.activePlanDigest, eligibleTaskIds: binding.eligibleTaskIds })) fail('独立reservation来源绑定失效')
+  // Recompute eligibility with only this reservation's own projection neutralized.
+  // Other reservations, Owners and all dependency/source evidence remain intact.
+  const view = structuredClone(state)
+  const key = `${binding.taskId}:${binding.ownerId}`
+  const persisted = view.supervisorOutbox?.[key]
+  if (persisted?.reservationId !== binding.reservationId || JSON.stringify(persisted.candidatePause) !== JSON.stringify(binding)) fail('reservation已被替换')
+  const owner = view.ownerRuns?.[key]
+  if (owner && JSON.stringify(owner.candidatePause) !== JSON.stringify(binding)) fail('Owner已被其他执行替换')
+  delete view.supervisorOutbox[key]
+  if (view.ownerRuns) delete view.ownerRuns[key]
+  const task = view.tasks.find(task => task.taskId === binding.taskId)
+  if (!task) fail('reservation任务不存在')
+  Object.assign(task, { status: 'pending', executorId: null, cursor: null, unchangedPolls: 0, reason: null, action: null })
+  if (!prepare(view).receipt.scope.eligibleTaskIds.includes(binding.taskId)) fail('任务不再属于独立范围')
+  return binding
+}
