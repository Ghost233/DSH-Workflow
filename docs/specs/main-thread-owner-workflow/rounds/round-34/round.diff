+test('T23 SIGKILL after durable reservation allows exactly one original-identity Owner execution', async () => {
+  return withFixtureContainer(async fixtureParent => {
+    const producer = await killAtCheckpoint(startRestartChild({ mode: 'produce_reserved', fixtureParent }), 'reserved')
+    assert.equal(producer.checkpoint.modelRequests, 0)
+    assert.equal(producer.checkpoint.rawPresent, false)
+    const postKillState = await readFile(workflowStatePath(producer.checkpoint.root, producer.checkpoint.workflowId), 'utf8')
+    assert.equal(postKillState, producer.checkpoint.stateBytes)
+    const before = JSON.parse(postKillState)
+    assert.equal(before.ownerRuns['T1:api'].recoverySession, undefined)
+    assert.equal(before.recoveryAdmission.budget.totalUsed, 1)
+    const replay = await finishReplay({
+      mode: 'launch_reserved', root: producer.checkpoint.root, workflowId: producer.checkpoint.workflowId,
+      receipt: producer.checkpoint.receipt, request: producer.checkpoint.request,
+    })
+    assert.notEqual(replay.pid, producer.checkpoint.pid)
+    assert.equal(replay.beforeState, postKillState)
+    assert.deepEqual(replay.operationsAfterLaunch, { create: 1, resume: 0, followup: 1 })
+    assert.equal(replay.modelRequestsAfterLaunch, 2)
+    assert.deepEqual(replay.operationsAfterReplay, replay.operationsAfterLaunch)
+    assert.equal(replay.modelRequestsAfterReplay, replay.modelRequestsAfterLaunch)
+    assert.equal(replay.replay.outcome, 'settled_failed')
+    assert.deepEqual(replay.afterReplay, replay.settled)
+    const settled = JSON.parse(replay.settled.stateBytes)
+    const identity = producer.checkpoint.receipt.executionIdentity
+    assert.equal(settled.ownerRuns['T1:api'].sessionId, identity.sessionId)
+    assert.deepEqual(settled.ownerRuns['T1:api'].recoverySession.executionIdentity, identity)
+    assert.deepEqual(settled.ownerRuns['T1:api'].recoveryContinuation.executionIdentity, identity)
+    assert.equal(settled.recoveryAdmission.budget.totalUsed, before.recoveryAdmission.budget.totalUsed)
+    const attempt = settled.recoveryAdmission.budget.attempts.find(item => item.requestId === producer.checkpoint.receipt.requestId)
+    assert.equal(attempt.state, 'settled')
+    assert.equal(attempt.result.status, 'failed')
