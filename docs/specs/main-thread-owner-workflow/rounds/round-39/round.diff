+test('T23 SIGKILL after first physical append preserves identity without resend', async () => {
+  return withFixtureContainer(async fixtureParent => {
+    const producer = await killAtCheckpoint(startRestartChild({ mode: 'produce_first_append', fixtureParent }), 'first_append')
+    const cp = producer.checkpoint
+    assert.equal(cp.firstBatch.isMaterialized, false)
+    assert.ok(cp.firstBatch.eventTypes.length > 0)
+    const rows = cp.rawContent.trimEnd().split('\n').map(row => JSON.parse(row))
+    assert.equal(rows[0].type, 'session')
+    assert.deepEqual(rows.slice(1).map(row => row.type), cp.firstBatch.eventTypes)
+    assert.ok(['creating', 'created'].includes(cp.checkpoint.phase), cp.checkpoint.phase)
+    assert.notEqual(cp.checkpoint.budgetAttempt.state, 'settled')
+    const postKill = await capturePostKill(cp)
+    const state = JSON.parse(postKill.stateBytes)
+    assert.equal(state.recoveryAdmission.budget.totalUsed, 1)
+    assert.deepEqual(state.ownerRuns['T1:api'].recoverySession.executionIdentity, cp.receipt.executionIdentity)
+    const replay = await finishReplay({ root: cp.root, workflowId: cp.workflowId,
+      receipt: cp.receipt, request: cp.request, scenario: 'first_append' })
+    assert.notEqual(replay.pid, cp.pid)
+    assert.equal(replay.result.outcome, 'paused')
+    assert.equal(replay.result.phase, 'technical_pause')
+    assertReplayReadOnly(postKill, replay)
+    await writeEvidence('first-physical-append', producer, postKill, replay)
+  })
+})
