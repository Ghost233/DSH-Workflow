+async function assertUnsettledReplay(fixture, receipt, budgetBefore) {
+  const state = await readRecoverySessionState(fixture)
+  const run = state.ownerRuns['T1:api']
+  assert.deepEqual(state.recoveryAdmission.budget, budgetBefore)
+  assert.deepEqual(run.recoverySession.executionIdentity, receipt.executionIdentity)
+  assert.equal(run.recoverySession.successReceipt, undefined)
+  assert.equal(run.recoveryContinuation, undefined)
+  assert.ok(!['settled_failed', 'settled_succeeded'].includes(run.recoverySession.phase))
+  const raw = await fixture.readRaw(receipt.executionIdentity.sessionId)
+  assert.ok(raw)
+  const requests = fixture.adapter.requests.length
+  const calls = { create: 0, resume: 0, followup: 0 }
+  for (const method of ['create', 'resume']) {
+    const original = fixture.ctx.agents[method].bind(fixture.ctx.agents)
+    fixture.ctx.agents[method] = async (...args) => {
+      calls[method] += 1
+      const handle = await original(...args)
+      const followup = handle.agent.followup.bind(handle.agent)
+      handle.agent.followup = (...input) => { calls.followup += 1; return followup(...input) }
+      return handle
+    }
+  }
+  const replay = await fixture.runtime.reconcileRecoverySession(
+    fixture.admissionAgent, fixture.workflowId, request(receipt),
+  )
+  assert.equal(replay.outcome, 'paused')
+  assert.equal(replay.phase, 'technical_pause')
+  assert.deepEqual(calls, { create: 0, resume: 0, followup: 0 })
+  assert.equal(fixture.adapter.requests.length, requests)
+  assert.deepEqual(await readRecoverySessionState(fixture), state)
+  assert.deepEqual(await fixture.readRaw(receipt.executionIdentity.sessionId), raw)
+  return replay
+}
