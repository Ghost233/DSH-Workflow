+test('T22 L2 real PlanRevision pending_check cannot settle the prior recovery intent', async t => {
+  const fixture = await createRecoverySessionFixture(t, {
+    executable: true, modelScript: completedOwnerModelScript,
+  })
+  const receipt = await reserveRecoverySession(fixture)
+  const before = await readRecoverySessionState(fixture)
+  await fixture.runtime.runExternalOwner(
+    fixture.admissionAgent, fixture.workflowId, 'T1', 'api', undefined,
+    { recoverySessionRequest: request(receipt), deferFinish: true },
+  )
+  const synced = await readRecoverySessionState(fixture)
+  assert.equal(synced.ownerRuns['T1:api'].status, 'awaiting_finish')
+  assert.equal(synced.tasks.find(item => item.taskId === 'T1').status, 'running')
+  const candidatePlan = structuredClone(synced.plan)
+  candidatePlan.tasks.find(item => item.id === 'T1').done.push('Recheck this result under the revised acceptance obligation.')
+  const candidateDigest = createHash('sha256').update(JSON.stringify(candidatePlan)).digest('hex')
+  // Input fixture is an already-reviewed candidate. The production approval
+  // transaction, not this setup, must produce pending_check; no task or
+  // Owner completion/check state is written here.
+  await mutateRecoverySessionState(fixture, state => {
+    state.conversationRootSessionId = fixture.admissionAgent.id
+    state.pendingPlanRevision = {
+      number: 2, parent: 1, plan: candidatePlan, planDigest: candidateDigest,
+      intentIds: [], review: {
+        contract: 'DSH_PLAN_REVIEW_V1', status: 'passed',
+        summary: 'Controlled reviewed candidate input for the local consumer test.', issues: [],
+      },
+    }
+  })
+  await fixture.runtime.approvePendingPlanRevision(fixture.admissionAgent, candidateDigest)
+  const revised = await readRecoverySessionState(fixture)
+  assert.equal(revised.tasks.find(item => item.taskId === 'T1').checkState, 'pending_check')
+  assert.notEqual(revised.planDigest, synced.planDigest)
+  // Current fixed-verification evidence belongs to the old plan. The real
+  // finish gate rejects it before the later pending-check settlement branch.
+  await assert.rejects(
+    fixture.runtime.finishOwner(fixture.admissionAgent, fixture.workflowId, 'T1', 'api'),
+    /验证结果 planDigest .* 与当前 .* 不一致/u,
+  )
+  const finished = await readRecoverySessionState(fixture)
+  assert.equal(finished.tasks.find(item => item.taskId === 'T1').checkState, 'pending_check')
+  assert.equal(finished.ownerRuns['T1:api'].status, 'awaiting_finish')
+  // The revision also changes plan binding. Replay is therefore a combined
+  // pending-check/old-plan safety case, not an isolated same-plan proof.
+  const replay = await assertUnsettledReplay(fixture, receipt, before.recoveryAdmission.budget)
+  assert.equal(replay.reason, 'reservation_binding_mismatch')
+})
