/**
 * Conservative T-22 read-side reconciliation for one T-20 reserved session.
 *
 * The JSONL backend deliberately exposes `readFrom` as a valid-prefix view.
 * We therefore pair it with an independently complete raw artifact and two
 * stable snapshots.  This module never starts an agent, submits a prompt, or
 * settles a recovery budget; Runtime owns those mutations under its Owner
 * lease and workflow state lock.
 */

export const RECOVERY_SESSION_REQUEST_CONTRACT = 'DSH_RECOVERY_SESSION_REQUEST_V1'
export const RECOVERY_SESSION_RESULT_CONTRACT = 'DSH_RECOVERY_SESSION_RESULT_V1'
export const RECOVERY_SESSION_STATE_CONTRACT = 'DSH_RECOVERY_SESSION_STATE_V1'

function fail(reason) {
  throw new Error(`RecoverySession ${reason}`)
}

function plainRecord(value, name) {
  if (value === null || typeof value !== 'object' || Array.isArray(value)
    || Object.getPrototypeOf(value) !== Object.prototype
    || Object.getOwnPropertySymbols(value).length !== 0) fail(`${name}_invalid`)
  for (const descriptor of Object.values(Object.getOwnPropertyDescriptors(value))) {
    if (!descriptor.enumerable || !Object.hasOwn(descriptor, 'value')) fail(`${name}_invalid`)
  }
  return value
}

function exactKeys(value, keys, name) {
  plainRecord(value, name)
  const actual = Object.getOwnPropertyNames(value).sort()
  const expected = [...keys].sort()
  if (actual.length !== expected.length || actual.some((key, index) => key !== expected[index])) {
    fail(`${name}_invalid`)
  }
  return value
}

function text(value, name) {
  if (typeof value !== 'string' || value.trim() === '') fail(`${name}_invalid`)
  return value
}

function positiveInteger(value, name) {
  if (!Number.isSafeInteger(value) || value < 1) fail(`${name}_invalid`)
  return value
}

function canonical(value) {
  if (Array.isArray(value)) return `[${value.map(canonical).join(',')}]`
  if (value !== null && typeof value === 'object') {
    return `{${Object.keys(value).sort().map(key => `${JSON.stringify(key)}:${canonical(value[key])}`).join(',')}}`
  }
  return JSON.stringify(value)
}

function sameValue(left, right) {
  return canonical(left) === canonical(right)
}

function prompt(value, name = 'prompt') {
  exactKeys(value, ['id', 'content'], name)
  return { id: text(value.id, `${name}_id`), content: text(value.content, `${name}_content`) }
}

/** Validate the explicit local Runtime request.  Identity and authority are not caller fields. */
export function normalizeRecoverySessionRequest(value) {
  exactKeys(value, ['contract', 'taskId', 'ownerId', 'requestId', 'prompt'], 'request')
  if (value.contract !== RECOVERY_SESSION_REQUEST_CONTRACT) fail('request_contract_invalid')
  return {
    contract: RECOVERY_SESSION_REQUEST_CONTRACT,
    taskId: text(value.taskId, 'request_task_id'),
    ownerId: text(value.ownerId, 'request_owner_id'),
    requestId: text(value.requestId, 'request_request_id'),
    prompt: prompt(value.prompt),
  }
}

export function createRecoverySessionState({ intent, prompt: rawPrompt, ownerRunBinding }) {
  const message = prompt(rawPrompt)
  exactKeys(intent, [
    'intentKey', 'sourceId', 'strategy', 'planDigest', 'taskId', 'ownerId', 'rootProblemId',
    'requestId', 'attemptId', 'executionIdentity',
  ], 'intent')
  exactKeys(intent.executionIdentity, ['sessionId', 'promptId'], 'intent_execution_identity')
  exactKeys(ownerRunBinding, ['attempt', 'leaseToken'], 'owner_run_binding')
  const executionIdentity = {
    sessionId: text(intent.executionIdentity.sessionId, 'intent_session_id'),
    promptId: text(intent.executionIdentity.promptId, 'intent_prompt_id'),
  }
  if (message.id !== executionIdentity.promptId) fail('prompt_identity_mismatch')
  return {
    contract: RECOVERY_SESSION_STATE_CONTRACT,
    rootProblemId: text(intent.rootProblemId, 'intent_root_problem_id'),
    requestId: text(intent.requestId, 'intent_request_id'),
    attemptId: text(intent.attemptId, 'intent_attempt_id'),
    planDigest: text(intent.planDigest, 'intent_plan_digest'),
    executionIdentity,
    prompt: message,
    ownerRunBinding: {
      attempt: positiveInteger(ownerRunBinding.attempt, 'owner_run_attempt'),
      leaseToken: text(ownerRunBinding.leaseToken, 'owner_run_lease_token'),
    },
    phase: 'creating',
  }
}

function snapshotFor(snapshots, sessionId) {
  if (!Array.isArray(snapshots)) fail('snapshots_invalid')
  const matches = snapshots.filter(item => item?.header?.id === sessionId)
  if (matches.length > 1) fail('snapshot_duplicate')
  return matches[0]
}

function pause(reason, details = {}) {
  return { outcome: 'paused', phase: 'technical_pause', reason, ...details }
}

function rawJsonl(raw, sessionId) {
  if (raw === undefined) return undefined
  if (raw?.filename !== 'session.jsonl' || raw?.meta?.id !== sessionId
    || typeof raw?.content !== 'string' || !raw.content.endsWith('\n')) {
    fail('raw_artifact_invalid')
  }
  const lines = raw.content.slice(0, -1).split('\n')
  if (lines.length === 0 || lines[0] === '') fail('raw_artifact_invalid')
  const rows = []
  for (const line of lines) {
    if (line === '') fail('raw_artifact_torn')
    try {
      rows.push(JSON.parse(line))
    } catch {
      fail('raw_artifact_torn')
    }
  }
  const header = rows.shift()
  if (header?.type !== 'session' || header?.id !== sessionId) fail('raw_header_invalid')
  return rows.flatMap(decodePhysicalRecord)
}

function exactJsonKeys(value, keys, name) {
  if (value === null || typeof value !== 'object' || Array.isArray(value)
    || Object.keys(value).length !== keys.length || !keys.every(key => Object.hasOwn(value, key))) {
    fail(`${name}_invalid`)
  }
  return value
}

function packedPayload(value, name) {
  if (!Array.isArray(value) || value.length < 3 || value.length > 1024
    || value.some(item => typeof item !== 'string')) fail(`${name}_invalid`)
  return value
}

/**
 * The JSONL schema-17 packed-row interpreter.  It intentionally mirrors the
 * published durable format, then compares every reconstructed event with the
 * backend's `readFrom` result below.  Scalar rows stay opaque exactly as the
 * shared decoder does; an unsupported or malformed packed row is a pause.
 */
function decodePhysicalRecord(value) {
  if (value === null || typeof value !== 'object' || Array.isArray(value)
    || !['text-chunks', 'reasoning-chunks', 'tool-call-chunks'].includes(value.type)) {
    return [value]
  }
  const tag = value.type
  exactJsonKeys(value, ['type', 'seq0', 'time0', 'data'], `${tag}_row`)
  if (!Number.isSafeInteger(value.seq0) || value.seq0 < 0 || !Number.isSafeInteger(value.time0)) {
    fail(`${tag}_row_invalid`)
  }
  const data = value.data
  const tool = tag === 'tool-call-chunks'
  const allowed = tool
    ? (Object.hasOwn(data ?? {}, 'name')
        ? ['turn', 'step', 'index', 'id', 'name', 'dt', 'args']
        : ['turn', 'step', 'index', 'id', 'dt', 'args'])
    : ['turn', 'step', 'index', 'dt', 'texts']
  exactJsonKeys(data, allowed, `${tag}_data`)
  if (typeof data.turn !== 'number' || typeof data.step !== 'number' || typeof data.index !== 'number'
    || !Array.isArray(data.dt) || data.dt.some(item => !Number.isSafeInteger(item))) {
    fail(`${tag}_data_invalid`)
  }
  const payload = packedPayload(data[tool ? 'args' : 'texts'], `${tag}_data`)
  if (data.dt.length !== payload.length - 1
    || !Number.isSafeInteger(value.seq0 + payload.length - 1)
    || Buffer.byteLength(JSON.stringify(data)) > 1_048_576) fail(`${tag}_data_invalid`)
  const events = []
  let time = value.time0
  for (let index = 0; index < payload.length; index += 1) {
    if (index > 0) time += data.dt[index - 1]
    if (!Number.isSafeInteger(time)) fail(`${tag}_time_invalid`)
    const chunk = tool
      ? {
          type: 'tool-call-delta', index: data.index, id: data.id,
          ...(Object.hasOwn(data, 'name') ? { name: data.name } : {}),
          argumentsDelta: payload[index],
        }
      : { type: tag === 'text-chunks' ? 'text-delta' : 'reasoning-delta', index: data.index, text: payload[index] }
    if (tool && (typeof data.id !== 'string' || (Object.hasOwn(data, 'name') && typeof data.name !== 'string'))) {
      fail(`${tag}_data_invalid`)
    }
    events.push({
      type: 'assistant/chunk',
      seq: value.seq0 + index,
      time,
      data: { turn: data.turn, step: data.step, chunk },
    })
  }
  return events
}

function contiguous(events) {
  if (!Array.isArray(events)) fail('read_from_invalid')
  for (let index = 0; index < events.length; index += 1) {
    if (events[index]?.seq !== index) fail('read_from_non_contiguous')
  }
  return events
}

function eventData(event, type) {
  return event?.type === type && event.data !== null && typeof event.data === 'object'
    ? event.data
    : undefined
}

function insertedPrompts(events) {
  const messages = []
  for (const event of events) {
    const data = eventData(event, 'agent/inbox/spliced')
    if (!Array.isArray(data?.inserted)) continue
    messages.push(...data.inserted.filter(item => item?.role === 'user'))
  }
  return messages
}

function userMessages(events) {
  return events
    .filter(event => event?.type === 'user/message' && event?.data?.role === 'user')
    .map(event => event.data)
}

function samePrompt(value, expected) {
  return value?.id === expected.id
    && value?.role === 'user'
    && sameValue(value?.content, [{ type: 'text', text: expected.content }])
    && sameValue(value?.source, { kind: 'user' })
}

function turnStepFacts(events, expected) {
  const inputs = userMessages(events)
  const queued = insertedPrompts(events)
  if (inputs.some(item => !samePrompt(item, expected)) || queued.some(item => !samePrompt(item, expected))) {
    return pause('extra_or_wrong_input')
  }
  if (inputs.length === 0) {
    return queued.length === 1 ? { outcome: 'pending', phase: 'durably_queued' } : pause('prompt_not_observed')
  }
  if (inputs.length !== 1 || queued.length > 1) return pause('prompt_not_unique')

  const turns = events.filter(event => event?.type === 'turn/start').map(event => event.data?.turn)
  const steps = events.filter(event => event?.type === 'step/start').map(event => event.data)
  if (turns.length !== 1 || !Number.isSafeInteger(turns[0]) || steps.length !== 1
    || steps[0]?.turn !== turns[0] || !Number.isSafeInteger(steps[0]?.step)) {
    return pause('prompt_turn_step_ambiguous')
  }
  const turn = turns[0]
  const step = steps[0].step
  const turnEnds = events.filter(event => event?.type === 'turn/end' && event?.data?.turn === turn)
  const stepEnds = events.filter(event => event?.type === 'step/end'
    && event?.data?.turn === turn && event?.data?.step === step)
  if (turnEnds.length === 0) return { outcome: 'running', phase: 'observed_running', turn, step }
  if (turnEnds.length !== 1 || stepEnds.length !== 1) return pause('terminal_shape_ambiguous')
  const assistants = events.filter(event => event?.type === 'assistant/message'
    && event?.data?.turn === turn && event?.data?.step === step)
  if (assistants.length !== 1) return pause('terminal_assistant_ambiguous')
  return {
    outcome: 'observed_terminal',
    phase: 'observed_terminal',
    turn,
    step,
    terminalSeq: turnEnds[0].seq,
    assistantMessageId: assistants[0].data?.message?.id,
  }
}

/**
 * Read a real JSONL compression:none session without mutating it.  Any gap in
 * artifact integrity, snapshot stability, or prompt ownership remains a
 * technical pause.  `observed_terminal` is intentionally not a business or
 * T-13 terminal result.
 */
export async function inspectRecoverySession({ persistence, executionIdentity, prompt: rawPrompt, signal }) {
  exactKeys(executionIdentity, ['sessionId', 'promptId'], 'execution_identity')
  const sessionId = text(executionIdentity.sessionId, 'execution_session_id')
  const promptId = text(executionIdentity.promptId, 'execution_prompt_id')
  const expected = prompt(rawPrompt)
  if (expected.id !== promptId) fail('prompt_identity_mismatch')
  if (persistence?.supportsRawArtifacts !== true
    || persistence?.constructor?.name !== 'JsonlSessionPersistence'
    || persistence?.config?.compression !== 'none') {
    return pause('unsupported_persistence')
  }
  try {
    const before = snapshotFor(await persistence.listSnapshots(signal), sessionId)
    const raw = await persistence.readRaw(sessionId, signal)
    if (raw === undefined) return pause('raw_artifact_missing')
    const physicalEvents = rawJsonl(raw, sessionId)
    const read = await persistence.readFrom(sessionId, 0, signal)
    if (read?.meta?.id !== sessionId) return pause('read_identity_mismatch')
    const events = contiguous(read?.events)
    const after = snapshotFor(await persistence.listSnapshots(signal), sessionId)
    if (before === undefined || after === undefined || before.revision !== after.revision) {
      return pause('snapshot_changed')
    }
    if (physicalEvents.length !== events.length
      || physicalEvents.some((event, index) => !sameValue(event, events[index]))) {
      return pause('raw_read_mismatch')
    }
    return { ...turnStepFacts(events, expected), revision: before.revision }
  } catch (error) {
    if (signal?.aborted) throw error
    return pause('read_failed')
  }
}
