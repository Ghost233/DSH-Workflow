  assert.equal(state.ownerRuns['T1:api'].phase, 'awaiting_user_authority')
  assert.equal(Object.values(state.mainOutbox).length, 1)
  assert.equal(state.recoveryAdmission, undefined)
  assert.deepEqual(calls, { create: 0, resume: 0 })
})

test('T15 Supervisor does not infer recovery settlement from an actual integrated Git result', async t => {
  const f = await createRecoverySessionFixture(t, { executable: true, modelScript: completedModel })
  await f.runtime.recoverOwner(f.admissionAgent, f.workflowId, 'T1', 'api')
  // Keep the real verified/integrated commit, but inject an uncommitted receipt
  // projection. This is an entry-routing counterexample, not a crash proof.
  const before = await mutateRecoverySessionState(f, s => {
    s.status = 'running'
    s.ownerRuns['T1:api'].status = 'awaiting_finish'
    s.ownerRuns['T1:api'].recoverySession.phase = 'submitted'
    delete s.ownerRuns['T1:api'].recoverySession.successReceipt
    Object.assign(s.tasks[0], { status: 'pending', executorId: null, reason: null, action: null })
  })
  const calls = observe(f)
  await executeNextSupervisorTask(f, 'T1')
  const after = await readRecoverySessionState(f)
  assert.equal(after.supervisorOutbox['T1:api'].status, 'stopped')
  assert.equal(after.supervisorOutbox['T1:api'].recoveryPause.reason, 'owner_success_unsettled')
  assert.deepEqual(after.ownerRuns['T1:api'], before.ownerRuns['T1:api'])
  assert.deepEqual(after.recoveryAdmission, before.recoveryAdmission)
  assert.equal(f.adapter.requests.length, 4)
  assert.deepEqual(calls, { create: 0, resume: 0 })
})

test('T15 Supervisor reserved recovery slot cannot generate phantom Owner execution timeouts', async t => {
  const f = await createRecoverySessionFixture(t, { executable: true })
  const next = await supervisorControl(f, 'supervisor-next')
  await supervisorControl(f, 'supervisor-ack', { actionId: next.actionId })
  const before = await mutateRecoverySessionState(f, s => {
    s.supervisorOutbox['T1:api'].status = 'launching'
    s.supervisorOutbox['T1:api'].launchedAt = '2000-01-01T00:00:00.000Z'
  })
  assert.equal(before.tasks[0].status, 'pending')
  let cursor = before.supervisorEventCursor
  for (let i = 0; i < 2; i++) {
    const observation = await supervisorControl(f, 'supervisor-await-event', { cursor, waitMs: 1 })
    assert.equal(observation.kind, 'timeout')
    assert.equal(observation.event.type, 'supervisor.wait-timeout')
    cursor = observation.cursor
  }
  const after = await readRecoverySessionState(f)
  assert.equal(after.tasks[0].status, 'pending')
  assert.equal(after.supervisorTimeouts, undefined)
  assert.deepEqual(after.ownerRuns, before.ownerRuns)
  assert.deepEqual(after.recoveryAdmission, before.recoveryAdmission)
  assert.equal(f.adapter.requests.length, 0)
})

test('T15 whole-workflow recovery preserves failed source and queues a budgeted Supervisor execution', async t => {
  const f = await createRecoverySessionFixture(t, { executable: true, modelScript: failedModel,
    limits: { totalLimit: 1, problemLimit: 1 } })
  const before = await mutateRecoverySessionState(f, s => {
    s.status = 'failed'
    Object.assign(s.tasks[0], { status: 'stopped', reason: 'runtime_failed', action: 'retry_runtime' })
  })
  const calls = observe(f)
  await f.runtime.recoverWorkflow(f.admissionAgent, f.workflowId)
  const queued = await readRecoverySessionState(f)
  assert.deepEqual(queued.ownerRuns, before.ownerRuns)
  assert.equal(queued.recoveryAdmission, undefined)
  assert.equal(queued.supervisorOutbox['T1:api'].status, 'reserved')
  const reservationId = queued.supervisorOutbox['T1:api'].reservationId
  assert.ok(reservationId)
  await supervisorControl(f, 'supervisor-execute', { reservationId })
  await f.runtime.supervisorDispatches.get(`${f.workflowId}:T1:api`)
  const failed = await readRecoverySessionState(f)
  assert.equal(failed.recoveryAdmission.budget.totalUsed, 1)
  assert.equal(failed.recoveryAdmission.sources[0].sessionId, before.ownerRuns['T1:api'].sessionId)
  assert.equal(failed.ownerRuns['T1:api'].recoverySession.phase, 'settled_failed')
  assert.equal(f.adapter.requests.length, 2)
  assert.deepEqual(calls, { create: 1, resume: 0 })
})

test('T15 whole-workflow recovery keeps typed user decisions ahead of handoff and bulk requeue', async t => {
  const f = await createRecoverySessionFixture(t, { executable: true, includeIndependentOwner: true })
  await admitAuthorityFailure(f)
  const before = await mutateRecoverySessionState(f, s => {
    s.status = 'blocked'
    s.handoffQueue = [{ sourceTaskId: 'T1', status: 'pending' }]
  })
  await f.runtime.recoverWorkflow(f.admissionAgent, f.workflowId)
  const after = await readRecoverySessionState(f)
  assert.equal(after.tasks[0].action, 'await_user')
  assert.equal(after.ownerRuns['T1:api'].phase, 'awaiting_user_authority')
  assert.equal(Object.values(after.mainOutbox).length, 1)
  assert.deepEqual(after.tasks[1], before.tasks[1])
  assert.equal(after.supervisorOutbox, undefined)
  assert.equal(after.recoveryAdmission, undefined)
  assert.equal(f.adapter.requests.length, 0)
})

for (const path of ['finishable', 'pending_merge']) {
  test(`T15 whole-workflow ${path} recovery cannot bypass an unsettled session`, async t => {
    const f = await createRecoverySessionFixture(t, { executable: true, modelScript: completedModel })
    await f.runtime.recoverOwner(f.admissionAgent, f.workflowId, 'T1', 'api')
    const before = await mutateRecoverySessionState(f, s => {
      s.status = 'failed'
      s.ownerRuns['T1:api'].status = 'awaiting_finish'
      s.ownerRuns['T1:api'].recoverySession.phase = 'submitted'
      delete s.ownerRuns['T1:api'].recoverySession.successReceipt
      if (path === 'pending_merge') s.pendingTaskMerge = { taskId: 'T1', ownerId: 'api' }
      Object.assign(s.tasks[0], { status: 'pending', executorId: null, reason: null, action: null })
    })
    const calls = observe(f)
    const result = await f.runtime.recoverWorkflow(f.admissionAgent, f.workflowId)
    assert.equal(result.outcome, 'paused')
    assert.equal(result.reason, 'owner_success_unsettled')
    assert.deepEqual(await readRecoverySessionState(f), before)
    assert.deepEqual(calls, { create: 0, resume: 0 })
  })
}

test('T15 whole-workflow missing configuration cannot fall back to legacy recovery', async t => {
  const f = await createRecoverySessionFixture(t, { executable: true })
  const before = await mutateRecoverySessionState(f, s => {
    s.status = 'failed'
    s.recoveryProtocol = 'DSH_RECOVERY_ADMISSION_V1'
    delete s.recoveryAdmissionConfig
  })
  await assert.rejects(f.runtime.recoverWorkflow(f.admissionAgent, f.workflowId))
  assert.deepEqual(await readRecoverySessionState(f), before)
  assert.equal(f.adapter.requests.length, 0)
})

test('T15 whole-workflow unknown Owner source is not rewritten into a free initial launch', async t => {
  const f = await createRecoverySessionFixture(t, { executable: true })
  const before = await mutateRecoverySessionState(f, s => {
    s.status = 'failed'
    s.ownerRuns['T1:api'].status = 'orphaned'
    Object.assign(s.tasks[0], { status: 'stopped', reason: 'owner_orphaned', action: 'recover_owner' })
  })
  await assert.rejects(f.runtime.recoverWorkflow(f.admissionAgent, f.workflowId), /没有可核验的恢复来源/u)
  assert.deepEqual(await readRecoverySessionState(f), before)
  assert.equal(f.adapter.requests.length, 0)
})

for (const totalLimit of [1, 2]) {
  test(`T15 convergence probe preserves failed source and the ${totalLimit}-credit limit`, async t => {
    const f = await createRecoverySessionFixture(t, { executable: true,
      limits: { totalLimit, problemLimit: totalLimit },
      modelScript: m => [...failedModel(m), ...failedModel(m)] })
    const calls = observe(f)
    await assert.rejects(f.runtime.recoverOwner(f.admissionAgent, f.workflowId, 'T1', 'api'), { name: 'OwnerReportedError' })
    const before = await mutateRecoverySessionState(f, s => {
      s.status = 'running'
      Object.assign(s.tasks[0], { status: 'stopped', reason: 'runtime_failed', action: 'retry_runtime',
        autonomousRecovery: { contract: 'DSH_AUTONOMOUS_RECOVERY_V1', strategy: 'autonomous_incident',
          failureClass: 'transient', evidenceDigest: '0'.repeat(64), usedStrategies: [] } })
    })
    const probe = await f.runtime.driveWorkflow(f.admissionAgent, f.workflowId, 'convergence-probe')
    assert.equal(probe.resumed, true)
    const queued = await readRecoverySessionState(f)
    assert.deepEqual(queued.ownerRuns, before.ownerRuns)
    assert.deepEqual(queued.recoveryAdmission, before.recoveryAdmission)
    assert.equal(queued.tasks[0].status, 'pending')
    await executeNextSupervisorTask(f, 'T1')
    const after = await readRecoverySessionState(f)
    assert.equal(after.recoveryAdmission.budget.totalUsed, totalLimit)
    assert.equal(after.recoveryAdmission.budget.problems.length, 1)
    assert.equal(after.supervisorOutbox['T1:api'].status, totalLimit === 1 ? 'stopped' : 'failed')
    assert.equal(f.adapter.requests.length, totalLimit * 2)
    assert.deepEqual(calls, { create: totalLimit, resume: 0 })
  })
}

test('T15 convergence probe persists typed user authority instead of resuming technical execution', async t => {
  const f = await createRecoverySessionFixture(t, { executable: true })
  await admitAuthorityFailure(f)
  await mutateRecoverySessionState(f, s => {
    s.status = 'running'
    Object.assign(s.tasks[0], { status: 'stopped', reason: 'runtime_failed', action: 'retry_runtime',
      autonomousRecovery: { contract: 'DSH_AUTONOMOUS_RECOVERY_V1', strategy: 'autonomous_incident',
        failureClass: 'transient', evidenceDigest: '0'.repeat(64), usedStrategies: [] } })
  })
  const result = await f.runtime.driveWorkflow(f.admissionAgent, f.workflowId, 'convergence-probe')
  assert.equal(result.resumed, false)
  assert.deepEqual(result.authorityTasks, ['T1'])
  const after = await readRecoverySessionState(f)
  assert.equal(after.tasks[0].action, 'await_user')
  assert.equal(after.ownerRuns['T1:api'].phase, 'awaiting_user_authority')
  assert.equal(Object.values(after.mainOutbox).length, 1)
  assert.equal(after.recoveryAdmission, undefined)
  assert.equal(f.adapter.requests.length, 0)
})

