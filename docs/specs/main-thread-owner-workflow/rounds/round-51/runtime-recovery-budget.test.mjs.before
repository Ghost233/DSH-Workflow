test('T15 convergence probe rejects missing protected configuration without a legacy fallback', async t => {
  const f = await createRecoverySessionFixture(t, { executable: true })
  const before = await mutateRecoverySessionState(f, s => {
    s.recoveryProtocol = 'DSH_RECOVERY_ADMISSION_V1'
    delete s.recoveryAdmissionConfig
  })
  await assert.rejects(f.runtime.probeAutonomousConvergence(f.admissionAgent, f.workflowId))
