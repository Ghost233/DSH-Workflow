import assert from 'node:assert/strict'
import { appendFile, mkdir, readFile, rm, writeFile } from 'node:fs/promises'
import { dirname } from 'node:path'
import test from 'node:test'

import {
  RECOVERY_SESSION_REQUEST_CONTRACT,
  inspectRecoverySession,
} from '../src/recovery-session.mjs'
import {
  appendObservedPrompt,
  createRecoverySessionFixture,
  injectObservedPrompt,
  mutateRecoverySessionState,
  readRecoverySessionState,
  reserveRecoverySession,
} from './fixtures/recovery-session-fixture.mjs'
import { createOwnerWorkflowRuntime } from '../src/runtime.mjs'

const content = 'recover the failed owner task'

function inspection(fixture, receipt) {
  return inspectRecoverySession({
    persistence: fixture.ctx.sessionPersistence,
    executionIdentity: receipt.executionIdentity,
    prompt: { id: receipt.executionIdentity.promptId, content },
  })
}

function request(receipt, prompt = { id: receipt.executionIdentity.promptId, content }) {
  return {
    contract: RECOVERY_SESSION_REQUEST_CONTRACT,
    taskId: 'T1',
    ownerId: 'api',
    requestId: receipt.requestId,
    prompt,
  }
}

function assertLeaseUnavailable(result) {
  assert.equal(result.outcome, 'paused')
  assert.equal(result.phase, 'technical_pause')
  assert.equal(result.reason, 'owner_lease_unavailable')
}

async function assertNoReconcileEffects(fixture, receipt, stateBefore, requestsBefore) {
  assert.equal(fixture.adapter.requests.length, requestsBefore)
  assert.equal(await fixture.readRaw(receipt.executionIdentity.sessionId), undefined)
  assert.deepEqual(await readRecoverySessionState(fixture), stateBefore)
}

test('T22 source-plane JSONL observes exactly one completed reserved prompt without writes', async t => {
  const fixture = await createRecoverySessionFixture(t)
  const receipt = await reserveRecoverySession(fixture)
  const observed = await appendObservedPrompt(fixture, receipt, content)
  const rawBefore = await fixture.readRaw(receipt.executionIdentity.sessionId)
  const eventsBefore = await fixture.readFrom(receipt.executionIdentity.sessionId)
  const requestsBefore = fixture.adapter.requests.length

  const result = await inspection(fixture, receipt)

  assert.equal(result.outcome, 'observed_terminal')
  assert.equal(result.phase, 'observed_terminal')
  assert.equal(result.turn, 1)
  assert.equal(result.step, 1)
  assert.equal(fixture.adapter.requests.length, requestsBefore)
  assert.deepEqual(await fixture.readRaw(receipt.executionIdentity.sessionId), rawBefore)
  assert.deepEqual(await fixture.readFrom(receipt.executionIdentity.sessionId), eventsBefore)
  assert.equal((await readRecoverySessionState(fixture)).ownerRuns['T1:api'].recoverySession, undefined)
  assert.match(observed.location.path, /session\.jsonl$/)
})

test('T22 source-plane JSONL distinguishes no artifact from one durable idle inbox prompt', async t => {
  const absent = await createRecoverySessionFixture(t)
  const absentReceipt = await reserveRecoverySession(absent)
  const absentRequests = absent.adapter.requests.length
  assert.deepEqual(await inspection(absent, absentReceipt), {
    outcome: 'paused', phase: 'technical_pause', reason: 'raw_artifact_missing',
  })
  assert.equal(absent.adapter.requests.length, absentRequests)

  const pending = await createRecoverySessionFixture(t)
  const pendingReceipt = await reserveRecoverySession(pending)
  await injectObservedPrompt(pending, pendingReceipt, content)
  const requestsBefore = pending.adapter.requests.length
  const result = await inspection(pending, pendingReceipt)
  assert.equal(result.outcome, 'pending')
  assert.equal(result.phase, 'durably_queued')
  assert.equal(pending.adapter.requests.length, requestsBefore)
})

test('T22 raw inspection pauses on duplicate input and malformed physical rows without re-sending', async t => {
  const duplicate = await createRecoverySessionFixture(t)
  const duplicateReceipt = await reserveRecoverySession(duplicate)
  const observed = await appendObservedPrompt(duplicate, duplicateReceipt, content)
  observed.agent.inject(duplicate.modules.freezeMessage({
    id: duplicateReceipt.executionIdentity.promptId,
    role: 'user',
    content: [{ type: 'text', text: content }],
    source: { kind: 'user' },
  }))
  await observed.agent.whenIdle()
  await duplicate.ctx.sessions.flush(observed.agent.session)
  const duplicateRequests = duplicate.adapter.requests.length
  const duplicateRaw = await duplicate.readRaw(duplicateReceipt.executionIdentity.sessionId)
  const duplicateResult = await inspection(duplicate, duplicateReceipt)
  assert.equal(duplicateResult.outcome, 'paused')
  assert.equal(duplicateResult.reason, 'prompt_not_unique')
  assert.equal(duplicate.adapter.requests.length, duplicateRequests)
  assert.deepEqual(await duplicate.readRaw(duplicateReceipt.executionIdentity.sessionId), duplicateRaw)

  const torn = await createRecoverySessionFixture(t)
  const tornReceipt = await reserveRecoverySession(torn)
  const tornObserved = await appendObservedPrompt(torn, tornReceipt, content)
  await appendFile(tornObserved.location.path, '{"type":"turn/end","seq":999}\n', 'utf8')
  const rawBefore = await readFile(tornObserved.location.path, 'utf8')
  const requestsBefore = torn.adapter.requests.length
  const tornResult = await inspection(torn, tornReceipt)
  assert.equal(tornResult.outcome, 'paused')
  assert.equal(torn.adapter.requests.length, requestsBefore)
  assert.equal(await readFile(tornObserved.location.path, 'utf8'), rawBefore)

  const truncated = await createRecoverySessionFixture(t)
  const truncatedReceipt = await reserveRecoverySession(truncated)
  const truncatedObserved = await appendObservedPrompt(truncated, truncatedReceipt, content)
  await appendFile(truncatedObserved.location.path, '{"type":"turn/end"', 'utf8')
  const truncatedRaw = await readFile(truncatedObserved.location.path, 'utf8')
  const truncatedRequests = truncated.adapter.requests.length
  const truncatedResult = await inspection(truncated, truncatedReceipt)
  assert.equal(truncatedResult.outcome, 'paused')
  assert.equal(truncated.adapter.requests.length, truncatedRequests)
  assert.equal(await readFile(truncatedObserved.location.path, 'utf8'), truncatedRaw)
})

test('T22 Runtime rejects wrong reservation binding and pauses the unready producer before session effects', async t => {
  const fixture = await createRecoverySessionFixture(t)
  const receipt = await reserveRecoverySession(fixture)
  const requestsBefore = fixture.adapter.requests.length

  const wrong = await fixture.runtime.reconcileRecoverySession(
    fixture.admissionAgent,
    fixture.workflowId,
    request(receipt, { id: `${receipt.executionIdentity.promptId}-wrong`, content }),
  )
  assert.equal(wrong.outcome, 'paused')
  assert.equal(wrong.reason, 'reservation_binding_mismatch')

  const current = await fixture.runtime.reconcileRecoverySession(
    fixture.admissionAgent,
    fixture.workflowId,
    request(receipt),
  )
  assert.equal(current.outcome, 'paused')
  // The minimal test root has no live Owner Registry.  A production-valid
  // root reaches owner_execution_adapter_not_ready after this same gate.
  assert.equal(current.reason, 'owner_start_not_authorized')
  assert.equal(fixture.adapter.requests.length, requestsBefore)
  assert.equal(await fixture.readRaw(receipt.executionIdentity.sessionId), undefined)
  const state = await readRecoverySessionState(fixture)
  assert.equal(state.ownerRuns['T1:api'].recoverySession, undefined)
  assert.equal(state.ownerSessions[receipt.executionIdentity.sessionId], undefined)
})

test('T22 refuses a real JSONL backend configured with compression before any read or retry', async t => {
  const fixture = await createRecoverySessionFixture(t, { compression: 'zstd' })
  const receipt = await reserveRecoverySession(fixture)
  const requestsBefore = fixture.adapter.requests.length
  const result = await inspection(fixture, receipt)
  assert.deepEqual(result, {
    outcome: 'paused', phase: 'technical_pause', reason: 'unsupported_persistence',
  })
  assert.equal(fixture.adapter.requests.length, requestsBefore)
})

test('F16 maps real same-process and independent-runtime Owner lease conflicts to a non-mutating pause', async t => {
  const sameRuntime = await createRecoverySessionFixture(t)
  const sameReceipt = await reserveRecoverySession(sameRuntime)
  const sameState = await readRecoverySessionState(sameRuntime)
  const sameRequests = sameRuntime.adapter.requests.length
  const held = await sameRuntime.runtime.acquireOwnerLease(
    sameRuntime.root, 'api', sameRuntime.workflowId, 'T2',
  )
  assert.equal(held.owned, true)
  const heldBytes = await readFile(held.lease.path, 'utf8')
  try {
    assertLeaseUnavailable(await sameRuntime.runtime.reconcileRecoverySession(
      sameRuntime.admissionAgent, sameRuntime.workflowId, request(sameReceipt),
    ))
    assert.equal(await readFile(held.lease.path, 'utf8'), heldBytes)
    await assertNoReconcileEffects(sameRuntime, sameReceipt, sameState, sameRequests)
  } finally {
    await sameRuntime.runtime.releaseOwnerLease(held.lease)
  }

  const reentrant = await createRecoverySessionFixture(t)
  const reentrantReceipt = await reserveRecoverySession(reentrant)
  const reentrantState = await readRecoverySessionState(reentrant)
  const reentrantRequests = reentrant.adapter.requests.length
  const reentrantHolder = await reentrant.runtime.acquireOwnerLease(
    reentrant.root, 'api', reentrant.workflowId, 'T1',
  )
  assert.equal(reentrantHolder.owned, true)
  const reentrantBytes = await readFile(reentrantHolder.lease.path, 'utf8')
  try {
    // Same task returns acquireOwnerLease(...).owned === false.  The new
    // entrypoint must treat it as unavailable rather than enter a re-entrant
    // critical section or expose withOwnerLease's ordinary rejection.
    assertLeaseUnavailable(await reentrant.runtime.reconcileRecoverySession(
      reentrant.admissionAgent, reentrant.workflowId, request(reentrantReceipt),
    ))
    assert.equal(await readFile(reentrantHolder.lease.path, 'utf8'), reentrantBytes)
    await assertNoReconcileEffects(reentrant, reentrantReceipt, reentrantState, reentrantRequests)
  } finally {
    await reentrant.runtime.releaseOwnerLease(reentrantHolder.lease)
  }

  const onDisk = await createRecoverySessionFixture(t)
  const onDiskReceipt = await reserveRecoverySession(onDisk)
  const onDiskState = await readRecoverySessionState(onDisk)
  const onDiskRequests = onDisk.adapter.requests.length
  // A separate Runtime has no shared in-memory lease map: the contention is
  // observed through the same real on-disk lease file, not a stubbed backend.
  const foreignRuntime = createOwnerWorkflowRuntime(onDisk.ctx, {})
  const foreign = await foreignRuntime.acquireOwnerLease(onDisk.root, 'api', onDisk.workflowId, 'T2')
  assert.equal(foreign.owned, true)
  const foreignBytes = await readFile(foreign.lease.path, 'utf8')
  try {
    assertLeaseUnavailable(await onDisk.runtime.reconcileRecoverySession(
      onDisk.admissionAgent, onDisk.workflowId, request(onDiskReceipt),
    ))
    assert.equal(await readFile(foreign.lease.path, 'utf8'), foreignBytes)
    await assertNoReconcileEffects(onDisk, onDiskReceipt, onDiskState, onDiskRequests)
  } finally {
    await foreignRuntime.releaseOwnerLease(foreign.lease)
  }
})

test('F16 maps a real lease directory still initializing to a non-mutating pause', async t => {
  const fixture = await createRecoverySessionFixture(t)
  const receipt = await reserveRecoverySession(fixture)
  const stateBefore = await readRecoverySessionState(fixture)
  const requestsBefore = fixture.adapter.requests.length
  const directory = fixture.runtime.leasePath(fixture.root, 'owner-api')
  await mkdir(directory, { recursive: true })
  try {
    assertLeaseUnavailable(await fixture.runtime.reconcileRecoverySession(
      fixture.admissionAgent, fixture.workflowId, request(receipt),
    ))
    assert.equal(await fixture.readRaw(receipt.executionIdentity.sessionId), undefined)
    assert.deepEqual(await readRecoverySessionState(fixture), stateBefore)
    assert.equal(fixture.adapter.requests.length, requestsBefore)
    await assert.rejects(readFile(`${directory}/lease.json`, 'utf8'), { code: 'ENOENT' })
  } finally {
    await rm(directory, { recursive: true, force: true })
  }
})

test('F16 leaves ordinary lease I/O errors and caller cancellation as rejections', async t => {
  const io = await createRecoverySessionFixture(t)
  const ioReceipt = await reserveRecoverySession(io)
  const ioState = await readRecoverySessionState(io)
  const ioRequests = io.adapter.requests.length
  const leaseDirectory = io.runtime.leasePath(io.root, 'owner-api')
  await mkdir(dirname(leaseDirectory), { recursive: true })
  await writeFile(leaseDirectory, 'not a lease directory\n', 'utf8')
  try {
    await assert.rejects(io.runtime.reconcileRecoverySession(
      io.admissionAgent, io.workflowId, request(ioReceipt),
    ))
    await assertNoReconcileEffects(io, ioReceipt, ioState, ioRequests)
  } finally {
    await rm(leaseDirectory, { force: true })
  }

  const cancelled = await createRecoverySessionFixture(t)
  const cancelledReceipt = await reserveRecoverySession(cancelled)
  const cancelledState = await readRecoverySessionState(cancelled)
  const cancelledRequests = cancelled.adapter.requests.length
  const controller = new AbortController()
  controller.abort(new Error('test caller cancelled'))
  await assert.rejects(cancelled.runtime.reconcileRecoverySession(
    cancelled.admissionAgent, cancelled.workflowId, request(cancelledReceipt), controller.signal,
  ))
  await assertNoReconcileEffects(cancelled, cancelledReceipt, cancelledState, cancelledRequests)
})

test('T22 starts the reserved Owner once, settles its real failed submission, and never rewrites the frozen instruction', async t => {
  const failedReport = {
    contract: 'DSH_OWNER_RESULT_V1',
    status: 'failed',
    summary: 'Controlled Owner reports that recovery cannot complete.',
    changes: [], tests: [], handoffs: [], memory_updates: [],
  }
  // The fixture uses the source Harness provider, a live Owner Registry and
  // controlled Owner worktree/branch.  MockAdapter supplies only this model
  // stream; owner_submit is the exact production tool definition registered
  // against this Runtime, rather than a test handler or full plugin host.
  const fixture = await createRecoverySessionFixture(t, {
    executable: true,
    modelScript: ({ toolCallResponse, textResponse }) => [
      toolCallResponse('t22-owner-submit-failed', 'owner_submit', { report: failedReport }),
      // Harness makes one final model step after the tool result before the
      // source provider returns the submitted Owner report.
      textResponse('submission recorded'),
    ],
  })
  const receipt = await reserveRecoverySession(fixture)
  const initialRequest = request(receipt)

  await assert.rejects(
    fixture.runtime.reconcileRecoverySession(fixture.admissionAgent, fixture.workflowId, initialRequest),
    error => error?.name === 'OwnerReportedError',
  )
  assert.equal(fixture.adapter.requests.length, 2)

  const settled = await readRecoverySessionState(fixture)
  const run = settled.ownerRuns['T1:api']
  assert.equal(run.status, 'failed')
  assert.equal(run.attempt, 3)
  assert.equal(run.sessionId, receipt.executionIdentity.sessionId)
  assert.equal(run.recoverySession.phase, 'settled_failed')
  assert.deepEqual(run.recoverySession.executionIdentity, receipt.executionIdentity)
  assert.deepEqual(run.recoverySession.instruction, {
    id: receipt.executionIdentity.promptId,
    content,
  })
  assert.equal(run.recoverySession.prompt.id, receipt.executionIdentity.promptId)
  assert.match(run.recoverySession.prompt.content, /恢复执行上下文/u)
  assert.match(run.recoverySession.prompt.content, new RegExp(content))
  assert.deepEqual(run.recoveryContinuation.executionIdentity, receipt.executionIdentity)
  assert.deepEqual(run.recoveryContinuation.ownerRunBinding, {
    attempt: 3,
    sessionId: receipt.executionIdentity.sessionId,
  })

  const budgetAttempt = settled.recoveryAdmission.budget.attempts.find(
    item => item.requestId === receipt.requestId,
  )
  assert.equal(budgetAttempt.state, 'settled')
  assert.deepEqual(budgetAttempt.executionRef, {
    id: receipt.executionIdentity.sessionId,
    version: receipt.executionIdentity.promptId,
  })
  assert.deepEqual(budgetAttempt.result, {
    status: 'failed',
    reference: {
      id: receipt.executionIdentity.promptId,
      version: receipt.executionIdentity.sessionId,
    },
  })

  const raw = await fixture.readRaw(receipt.executionIdentity.sessionId)
  assert.ok(raw)
  assert.match(raw.content, /"type":"user\/message"/u)
  assert.ok(raw.content.includes(receipt.executionIdentity.promptId))
  assert.match(raw.content, /"name":"owner_submit"/u)

  const requestsBeforeReplay = fixture.adapter.requests.length
  const replay = await fixture.runtime.reconcileRecoverySession(
    fixture.admissionAgent, fixture.workflowId, initialRequest,
  )
  assert.equal(replay.outcome, 'settled_failed')
  assert.equal(replay.phase, 'settled_failed')
  assert.equal(fixture.adapter.requests.length, requestsBeforeReplay)
  assert.deepEqual(await readRecoverySessionState(fixture), settled)
  assert.deepEqual(await fixture.readRaw(receipt.executionIdentity.sessionId), raw)

  const changedInstruction = await fixture.runtime.reconcileRecoverySession(
    fixture.admissionAgent,
    fixture.workflowId,
    request(receipt, { id: receipt.executionIdentity.promptId, content: 'replacement recovery instruction' }),
  )
  assert.equal(changedInstruction.outcome, 'paused')
  assert.equal(changedInstruction.reason, 'persisted_owner_binding_mismatch')
  assert.equal(fixture.adapter.requests.length, requestsBeforeReplay)
  assert.deepEqual(await readRecoverySessionState(fixture), settled)
  assert.deepEqual(await fixture.readRaw(receipt.executionIdentity.sessionId), raw)

  // A legacy retry must not inherit a reserved identity from this failed
  // recovery. It needs an explicit new recovery request before a new attempt.
  await assert.rejects(
    fixture.runtime.runExternalOwner(fixture.admissionAgent, fixture.workflowId, 'T1', 'api'),
    /recovery|恢复/u,
  )
  assert.equal(fixture.adapter.requests.length, requestsBeforeReplay)
  assert.deepEqual(await readRecoverySessionState(fixture), settled)
  assert.deepEqual(await fixture.readRaw(receipt.executionIdentity.sessionId), raw)

  // Deliberate bad-state injection: the settled receipt still names the
  // reservation, but the current Owner run no longer names that session.
  // Reconciliation must not treat the old receipt as authorization to reuse
  // or launch anything, and must leave the malformed durable state untouched.
  const corruptSessionId = `${receipt.executionIdentity.sessionId}-wrong`
  const corrupted = await mutateRecoverySessionState(fixture, state => {
    state.ownerRuns['T1:api'].sessionId = corruptSessionId
  })
  const corruptReplay = await fixture.runtime.reconcileRecoverySession(
    fixture.admissionAgent, fixture.workflowId, initialRequest,
  )
  assert.equal(corruptReplay.outcome, 'paused')
  assert.equal(fixture.adapter.requests.length, requestsBeforeReplay)
  assert.deepEqual(await readRecoverySessionState(fixture), corrupted)
  assert.deepEqual(await fixture.readRaw(receipt.executionIdentity.sessionId), raw)
})
