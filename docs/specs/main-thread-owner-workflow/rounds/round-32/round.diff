+test('T22 L4 paused recovery leaves an independent Owner runnable in the same Runtime and ledger', async t => {
+  const fixture = await createRecoverySessionFixture(t, {
+    executable: true, includeIndependentOwner: true,
+    modelScript: modules => [
+      ...completedOwnerModelScript(modules).slice(0, 2),
+      ...completedOwnerModelScript(modules).slice(0, 2),
+    ],
+  })
+  const receipt = await reserveRecoverySession(fixture)
+  const first = await fixture.runtime.runExternalOwner(
+    fixture.admissionAgent, fixture.workflowId, 'T1', 'api', undefined,
+    { recoverySessionRequest: request(receipt), deferFinish: true },
+  )
+  assert.equal(first.phase, 'synced')
+  const pause = await fixture.runtime.reconcileRecoverySession(fixture.admissionAgent, fixture.workflowId, request(receipt))
+  assert.equal(pause.reason, 'owner_success_unsettled')
+  const before = await readRecoverySessionState(fixture)
+  const rawBefore = await fixture.readRaw(receipt.executionIdentity.sessionId)
+  const requestsBefore = fixture.adapter.requests.length
+  const independent = await fixture.runtime.runExternalOwner(
+    fixture.admissionAgent, fixture.workflowId, 'T2', 'worker', undefined, { deferFinish: true },
+  )
+  assert.equal(independent.phase, 'synced')
+  assert.match(independent.commitSha, /^[0-9a-f]{40}$/u)
+  assert.equal(fixture.adapter.requests.length, requestsBefore + 2)
+  const after = await readRecoverySessionState(fixture)
+  assert.deepEqual(after.recoveryAdmission, before.recoveryAdmission)
+  assert.deepEqual(after.ownerRuns['T1:api'], before.ownerRuns['T1:api'])
+  assert.deepEqual(await fixture.readRaw(receipt.executionIdentity.sessionId), rawBefore)
+  const other = after.ownerRuns['T2:worker']
+  assert.equal(other.status, 'awaiting_finish')
+  assert.equal(other.ownerId, 'worker')
+  assert.notEqual(other.sessionId, receipt.executionIdentity.sessionId)
+  assert.equal(other.recoverySession, undefined)
+  const events = await fixture.readFrom(other.sessionId)
+  assert.equal(events.events.filter(event => event.type === 'tool/call' && event.data.name === 'owner_submit').length, 1)
+  const again = await fixture.runtime.reconcileRecoverySession(fixture.admissionAgent, fixture.workflowId, request(receipt))
+  assert.deepEqual(again, pause)
+  assert.deepEqual(await readRecoverySessionState(fixture), after)
+  assert.equal(fixture.adapter.requests.length, requestsBefore + 2)
+})
