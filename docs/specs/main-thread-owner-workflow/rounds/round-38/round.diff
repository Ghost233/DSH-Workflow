+  test(`T23 ${boundary} SIGKILL cannot authorize an uncommitted identity`, async () => {
+    return withFixtureContainer(async fixtureParent => {
+      const producer = await killAtCheckpoint(startRestartChild({ mode: 'produce_admission_pending', boundary, fixtureParent }), boundary)
+      const cp = producer.checkpoint
+      const stateBytes = await readFile(workflowStatePath(cp.root, cp.workflowId), 'utf8')
+      assert.equal(stateBytes, cp.beforeState)
+      assert.equal(stateBytes, cp.stateBytes)
+      assert.equal(cp.modelRequests, 0)
+      assert.equal(cp.rawPresent, false)
+      const state = JSON.parse(stateBytes)
+      assert.equal(state.recoveryAdmission, undefined)
+      const pending = JSON.parse(cp.pendingBytes)
+      assert.equal(pending.recoveryAdmission.budget.totalUsed, 1)
+      assert.equal(pending.recoveryAdmission.intents.length, 1)
+      assert.deepEqual(pending.recoveryAdmission.intents[0], cp.candidateIntent)
+      if (boundary === 'admission_before_write') {
