+      }
+      const replay = await finishReplay({ ...cp, mode: 'replay_uncommitted' })
+      assert.notEqual(replay.pid, cp.pid)
+      assert.equal(replay.result.outcome, 'paused')
+      assert.equal(replay.result.reason, 'reservation_not_found')
