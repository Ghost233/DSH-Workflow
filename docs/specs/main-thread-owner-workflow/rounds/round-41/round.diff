+for (const corruption of ['bad_row', 'torn_tail', 'bad_budget']) {
+  test(`T23 Runtime rejects persistent ${corruption} after real prompt acceptance`, async () => {
+    return withFixtureContainer(async fixtureParent => {
+      const producer = await killAtCheckpoint(startRestartChild({ mode: 'produce_submitted', fixtureParent }), 'submitted')
+      const cp = producer.checkpoint
+      const originalState = await readFile(workflowStatePath(cp.root, cp.workflowId), 'utf8')
+      const originalRaw = await readFile(cp.rawLocationPath, 'utf8')
+      assert.equal(originalState, cp.stateBytes)
+      assert.equal(originalRaw, cp.rawContent)
+      assert.ok(originalRaw.includes(cp.receipt.executionIdentity.promptId))
+      if (corruption === 'bad_budget') {
+        const state = JSON.parse(originalState)
+        state.recoveryAdmission.budget.totalUsed = -1
+        await writeFile(workflowStatePath(cp.root, cp.workflowId), JSON.stringify(state, null, 2) + '\n', 'utf8')
+      } else {
+        const suffix = corruption === 'bad_row' ? '{"type":"turn/end","seq":999}\n' : '{"type":"turn/end"'
+        await writeFile(cp.rawLocationPath, originalRaw + suffix, 'utf8')
+      }
+      const corruptState = await readFile(workflowStatePath(cp.root, cp.workflowId), 'utf8')
+      const corruptRaw = await readFile(cp.rawLocationPath, 'utf8')
+      const replay = await finishReplay({ ...cp, mode: 'replay' })
+      assert.notEqual(replay.pid, cp.pid)
+      assert.equal(replay.result.outcome, 'paused')
+      if (corruption === 'bad_budget') assert.equal(replay.result.reason, 'reservation_invalid')
+      assertReplayReadOnly({ stateBytes: corruptState, rawContent: corruptRaw }, replay)
+      assert.equal(await readFile(workflowStatePath(cp.root, cp.workflowId), 'utf8'), corruptState)
