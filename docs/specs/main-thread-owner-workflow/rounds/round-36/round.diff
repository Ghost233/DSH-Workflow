+test('T23 distinct requests racing for the final credit execute only the admitted Owner', async () => {
+  return withFixtureContainer(async fixtureParent => {
+    const producer = await killAtCheckpoint(startRestartChild({ mode: 'produce_candidates', fixtureParent }), 'candidates')
+    const input = { mode: 'compete_credit', root: producer.checkpoint.root,
+      workflowId: producer.checkpoint.workflowId, planDigest: producer.checkpoint.planDigest }
+    const beforeBytes = await readFile(workflowStatePath(input.root, input.workflowId), 'utf8')
+    assert.equal(beforeBytes, producer.checkpoint.stateBytes)
+    const handles = [
+      startRestartChild({ ...input, taskId: 'T1', ownerId: 'api' }),
+      startRestartChild({ ...input, taskId: 'T2', ownerId: 'worker' }),
+    ]
+    let results
+    try {
+      const ready = await Promise.all(handles.map(handle => handle.message))
+      assert.ok(ready.every(item => item.type === 'ready'))
+      assert.notEqual(ready[0].pid, ready[1].pid)
+      const completions = handles.map(handle => Promise.race([
+        new Promise(resolve => handle.child.once('message', resolve)),
+        handle.exited.then(exit => { throw new Error(`competition child exited before result: ${JSON.stringify(exit)}; output=${JSON.stringify(handle.output())}`) }),
+      ]))
+      for (const handle of handles) handle.child.send({ type: 'go' })
+      results = await Promise.all(completions)
+      for (const result of results) assert.equal(result.type, 'competed', JSON.stringify(result))
+      for (const handle of handles) assert.deepEqual(await handle.exited, { code: 0, signal: null })
+    } finally {
+      for (const handle of handles) {
+        if (handle.child.exitCode === null && handle.child.signalCode === null) handle.child.kill('SIGKILL')
+      }
+      await Promise.all(handles.map(handle => handle.exited))
+    }
+
+    const winner = results.find(item => item.receipt.outcome === 'reserved')
+    const loser = results.find(item => item.receipt.outcome === 'rejected')
+    assert.ok(winner, JSON.stringify(results))
+    assert.ok(loser, JSON.stringify(results))
+    assert.equal(winner.errorName, 'OwnerReportedError')
+    assert.deepEqual(winner.operations, { create: 1, resume: 0, followup: 1 })
+    assert.equal(winner.modelRequests, 2)
+    assert.deepEqual(loser.operations, { create: 0, resume: 0, followup: 0 })
+    assert.equal(loser.modelRequests, 0)
+    const finalBytes = await readFile(workflowStatePath(input.root, input.workflowId), 'utf8')
+    const state = JSON.parse(finalBytes)
+    const before = JSON.parse(beforeBytes)
+    assert.equal(state.recoveryAdmission.budget.totalUsed, 1)
+    assert.equal(state.recoveryAdmission.intents.length, 1)
+    const run = state.ownerRuns[`${winner.taskId}:${winner.ownerId}`]
+    assert.deepEqual(run.recoverySession.executionIdentity, winner.receipt.executionIdentity)
+    assert.equal(run.recoverySession.phase, 'settled_failed')
+    assert.equal(run.sessionId, winner.receipt.executionIdentity.sessionId)
+    assert.deepEqual(state.ownerRuns[`${loser.taskId}:${loser.ownerId}`], before.ownerRuns[`${loser.taskId}:${loser.ownerId}`])
+    const raw = await readFile(winner.rawPath, 'utf8')
+    assert.equal(raw, winner.raw.content)
+    const calls = raw.trimEnd().split('\n').map(row => JSON.parse(row))
+      .filter(row => row.type === 'tool/call' && row.data.name === 'owner_submit')
+    assert.equal(calls.length, 1)
+    const directory = join(EVIDENCE_ROOT, 'distinct-credit-concurrent-execution')
+    await mkdir(directory, { recursive: true })
+    await writeFile(join(directory, 'proof.json'), JSON.stringify({ producer, results, beforeBytes, finalBytes, raw }, null, 2) + '\n', 'utf8')
+  })
+})
