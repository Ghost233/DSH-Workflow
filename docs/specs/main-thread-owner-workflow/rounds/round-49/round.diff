+
+for (const totalLimit of [1, 2]) {
+  test(`T15 convergence probe preserves failed source and the ${totalLimit}-credit limit`, async t => {
+    const f = await createRecoverySessionFixture(t, { executable: true,
+      limits: { totalLimit, problemLimit: totalLimit },
+      modelScript: m => [...failedModel(m), ...failedModel(m)] })
+    const calls = observe(f)
+    await assert.rejects(f.runtime.recoverOwner(f.admissionAgent, f.workflowId, 'T1', 'api'), { name: 'OwnerReportedError' })
+    const before = await mutateRecoverySessionState(f, s => {
+      s.status = 'running'
+      Object.assign(s.tasks[0], { status: 'stopped', reason: 'runtime_failed', action: 'retry_runtime',
+        autonomousRecovery: { contract: 'DSH_AUTONOMOUS_RECOVERY_V1', strategy: 'autonomous_incident',
+          failureClass: 'transient', evidenceDigest: '0'.repeat(64), usedStrategies: [] } })
+    })
+    const probe = await f.runtime.driveWorkflow(f.admissionAgent, f.workflowId, 'convergence-probe')
+    assert.equal(probe.resumed, true)
+    const queued = await readRecoverySessionState(f)
+    assert.deepEqual(queued.ownerRuns, before.ownerRuns)
+    assert.deepEqual(queued.recoveryAdmission, before.recoveryAdmission)
+    assert.equal(queued.tasks[0].status, 'pending')
+    await executeNextSupervisorTask(f, 'T1')
+    const after = await readRecoverySessionState(f)
+    assert.equal(after.recoveryAdmission.budget.totalUsed, totalLimit)
+    assert.equal(after.recoveryAdmission.budget.problems.length, 1)
+    assert.equal(after.supervisorOutbox['T1:api'].status, totalLimit === 1 ? 'stopped' : 'failed')
+    assert.equal(f.adapter.requests.length, totalLimit * 2)
+    assert.deepEqual(calls, { create: totalLimit, resume: 0 })
+  })
+}
+
+test('T15 convergence probe persists typed user authority instead of resuming technical execution', async t => {
+  const f = await createRecoverySessionFixture(t, { executable: true })
+  await admitAuthorityFailure(f)
+  await mutateRecoverySessionState(f, s => {
+    s.status = 'running'
+    Object.assign(s.tasks[0], { status: 'stopped', reason: 'runtime_failed', action: 'retry_runtime',
+      autonomousRecovery: { contract: 'DSH_AUTONOMOUS_RECOVERY_V1', strategy: 'autonomous_incident',
+        failureClass: 'transient', evidenceDigest: '0'.repeat(64), usedStrategies: [] } })
+  })
+  const result = await f.runtime.driveWorkflow(f.admissionAgent, f.workflowId, 'convergence-probe')
+  assert.equal(result.resumed, false)
+  assert.deepEqual(result.authorityTasks, ['T1'])
+  const after = await readRecoverySessionState(f)
+  assert.equal(after.tasks[0].action, 'await_user')
+  assert.equal(after.ownerRuns['T1:api'].phase, 'awaiting_user_authority')
+  assert.equal(Object.values(after.mainOutbox).length, 1)
+  assert.equal(after.recoveryAdmission, undefined)
+  assert.equal(f.adapter.requests.length, 0)
+})
+
+test('T15 convergence probe cannot manufacture a recoverable Owner from an orphaned source', async t => {
+  const f = await createRecoverySessionFixture(t, { executable: true })
+  const before = await mutateRecoverySessionState(f, s => {
+    s.ownerRuns['T1:api'].status = 'orphaned'
+    Object.assign(s.tasks[0], { status: 'stopped', reason: 'owner_orphaned', action: 'recover_owner',
+      autonomousRecovery: { contract: 'DSH_AUTONOMOUS_RECOVERY_V1', strategy: 'autonomous_incident',
+        failureClass: 'transient', evidenceDigest: '0'.repeat(64), usedStrategies: [] } })
+  })
+  const result = await f.runtime.driveWorkflow(f.admissionAgent, f.workflowId, 'convergence-probe')
+  assert.equal(result.resumed, false)
+  assert.deepEqual(await readRecoverySessionState(f), before)
+  assert.equal(f.adapter.requests.length, 0)
+})
+
