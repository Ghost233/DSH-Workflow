+  }
+}
+// Captured by the actual provider pre-step boundary before the model sees the
+// snapshot. Matching a plugin name in a log alone never grants this allowance.
+export function normalizeReplanContexts(messages) {
+  if (!Array.isArray(messages)) throw new Error('ReplanSession contexts_invalid')
+  const ids = new Set()
+  return messages.map(message => {
+    exact(message, ['id', 'role', 'content', 'source'], 'context_message')
+    text(message.id, 'context_id')
+    if (ids.has(message.id) || message.role !== 'user' || !Array.isArray(message.content)
+      || message.content.length !== 1 || message.content[0]?.type !== 'text'
+      || typeof message.content[0].text !== 'string') throw new Error('ReplanSession context_message_invalid')
