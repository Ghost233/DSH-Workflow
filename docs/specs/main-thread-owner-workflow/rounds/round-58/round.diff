+    if (payload === null || typeof payload !== 'object' || Array.isArray(payload)) return pause('tool_payload_invalid')
+    accepted.push({
+      payload,
+      receipt: { toolName, callId: call.data.callId, callSeq: call.seq, resultSeq: result.seq,
+        payloadDigest: replanPayloadDigest(payload), terminalSeq: facts.terminalSeq, terminalKind: endKind, revision: facts.revision },
+    })
+  }
