import assert from 'node:assert/strict'
import { execFile } from 'node:child_process'
import test from 'node:test'
import { promisify } from 'node:util'
import { plannerSubmitDefinition, planReviewSubmitDefinition } from '../index.js'
import { candidateIndependentNext } from '../src/candidate-independent-supervisor.mjs'
import { deriveWorkflowControl } from '../src/workflow-state.mjs'
import {
  createRecoverySessionFixture,
  mutateRecoverySessionState,
  readRecoverySessionState,
  reopenRecoverySessionFixture,
} from './fixtures/recovery-session-fixture.mjs'

const execFileAsync = promisify(execFile)

async function git(cwd, args) {
  const { stdout } = await execFileAsync('git', ['-C', cwd, ...args], { encoding: 'utf8' })
  return stdout.trim()
}

function completedOwnerModel({ toolCallResponse, textResponse }) {
  return [
    toolCallResponse('candidate-independent-completed', 'owner_submit', { report: {
      contract: 'DSH_OWNER_RESULT_V1', status: 'completed', summary: 'Completed the independent task.',
      changes: [], tests: [], handoffs: [], memory_updates: [],
    } }),
    textResponse('The completed result has been submitted.'),
    textResponse(JSON.stringify({
      contract: 'DSH_OWNER_MEMORY_CURATOR_V1', summary: 'No knowledge pages needed.', pages: [],
    })),
    textResponse(JSON.stringify({
      contract: 'DSH_OWNER_MEMORY_REVIEW_V1', status: 'passed', summary: 'Empty bundle is valid.', issues: [],
    })),
  ]
}

function failedOwnerModel({ toolCallResponse, textResponse }) {
  return [
    toolCallResponse('candidate-independent-failed', 'owner_submit', { report: {
      contract: 'DSH_OWNER_RESULT_V1', status: 'failed', summary: 'Controlled independent Owner failure.',
      changes: [], tests: [], handoffs: [], memory_updates: [],
    } }),
    textResponse('The controlled failure has been submitted.'),
  ]
}

function sourceFootprint(state) {
  return {
    status: state.status,
    error: state.error,
    plan: state.plan,
    planDigest: state.planDigest,
    pendingPlanRevision: state.pendingPlanRevision,
    candidateRecoveryPause: state.candidateRecoveryPause,
    handoffQueue: state.handoffQueue,
    handoffReplans: state.handoffReplans,
    candidateReviews: state.candidateReviews,
    replanSessions: state.replanSessions,
    recoveryAdmission: state.recoveryAdmission,
    sourceTask: state.tasks.find(task => task.taskId === 'T1'),
    sourceOwner: state.ownerRuns['T1:api'],
  }
}

function pauseNotice(state) {
  return state.mainOutbox[state.candidateRecoveryPause.notificationId]
}

async function notifiedCandidatePause(t, ownerModel) {
  let plan
  const f = await createRecoverySessionFixture(t, {
    executable: true,
    includeIndependentOwner: true,
    limits: { totalLimit: 1, problemLimit: 1 },
    modelScript: m => [
      () => m.toolCallResponse('candidate-independent-planner', 'workflow_plan_submit', { plan }),
      'hang-slow',
      m.textResponse('Technical pause notice received.'),
      ...ownerModel(m),
    ],
  })
  f.ctx.tools.register(plannerSubmitDefinition(f.runtime))
  f.ctx.tools.register(planReviewSubmitDefinition(f.runtime))

  const state = await readRecoverySessionState(f)
  plan = {
    ...structuredClone(state.plan),
    summary: 'Candidate independent runtime proof.',
    owners: state.plan.owners.map(owner => ({ id: owner.id })),
  }
  const stage = state.plan.tasks.find(task => task.id === 'T1')
  const owner = state.plan.owners.find(item => item.id === stage.ownerId)
  await f.runtime.recordHandoffs(state, stage, { owner, branch: 'candidate-independent-fixture' }, {
    status: 'blocked',
    handoffs: [{
      targetType: 'owner', targetOwnerId: owner.id, files: ['src/api/repair.mjs'], summary: 'Repair the failed source task.',
    }],
  })
  await f.runtime.replanHandoffs(f.admissionAgent, f.workflowId)

  const paused = await f.runtime.driveWorkflow(f.admissionAgent, f.workflowId, 'plan-revision-drive')
  assert.equal(paused.action, 'candidate-recovery-paused')
  const notified = await f.runtime.driveWorkflow(f.admissionAgent, f.workflowId, 'plan-revision-drive')
  assert.equal(notified.action, 'candidate-recovery-notified')
  await f.admissionAgent.whenIdle()
  await f.ctx.sessions.flush(f.admissionAgent.session)

  const pausedState = await readRecoverySessionState(f)
  assert.equal(pausedState.recoveryAdmission.budget.totalUsed, 1)
  assert.equal(pausedState.mainOutbox[pausedState.candidateRecoveryPause.notificationId].status, 'delivered')
  return f
}

async function reserveIndependentTask(f) {
  const before = await readRecoverySessionState(f)
  const receipt = candidateIndependentNext(before)
  assert.equal(receipt.action, 'create')
  assert.deepEqual(receipt.tasks.map(task => task.taskId), ['T2'])
  assert.deepEqual(receipt.tasks.map(task => task.ownerId), ['worker'])
  const reserved = await f.runtime.reserveCandidateIndependentTasks(f.admissionAgent, f.workflowId, receipt.actionId)
  assert.equal(reserved.replay, false)
  assert.equal(reserved.reservations.length, 1)
  return { before, reservation: reserved.reservations[0] }
}

test('T15 candidate pause dispatch runs an independent Owner through verify, commit, merge, and finish', { timeout: 45_000 }, async t => {
  const f = await notifiedCandidatePause(t, completedOwnerModel)
  await mutateRecoverySessionState(f, state => {
    state.status = 'blocked'
    state.error = 'source recovery paused'
  })
  const { before, reservation } = await reserveIndependentTask(f)
  const protectedBefore = sourceFootprint(before)
  const noticeBefore = pauseNotice(before)

  const outcome = await f.runtime.runCandidateIndependentReservation(f.admissionAgent, f.workflowId, 'T2:worker')
  assert.equal(outcome.outcome, 'completed', outcome.reason)

  const after = await readRecoverySessionState(f)
  assert.deepEqual(sourceFootprint(after), protectedBefore)
  assert.deepEqual(pauseNotice(after), noticeBefore)
  const task = after.tasks.find(item => item.taskId === 'T2')
  const owner = after.ownerRuns['T2:worker']
  const settledReservation = after.supervisorOutbox['T2:worker']
  assert.equal(task.status, 'completed')
  assert.equal(task.checkState, 'valid')
  assert.equal(task.verificationResults.unit.passed, true)
  assert.equal(task.verificationResults.unit.exitCode, 0)
  assert.ok(task.verificationResults.unit.enforcement === 'full'
    || (task.verificationResults.unit.enforcement === 'approved-host'
      && task.verificationResults.unit.approvalOutcome === 'allowed-once'))
  assert.equal(task.fixedCommitSha, owner.result.commitSha)
  assert.equal(owner.status, 'completed')
  assert.notEqual(owner.result.commitSha, before.workflowHead)
  assert.notEqual(after.workflowHead, before.workflowHead)
  assert.equal(await git(after.workflowWorktree, ['rev-parse', 'HEAD']), after.workflowHead)
  await git(after.workflowWorktree, ['merge-base', '--is-ancestor', owner.result.commitSha, after.workflowHead])
  assert.deepEqual(owner.candidatePause, reservation.candidatePause)
  assert.equal(settledReservation.status, 'completed')
  assert.deepEqual(settledReservation.candidatePause, reservation.candidatePause)
  assert.equal(after.recoveryAdmission.budget.totalUsed, before.recoveryAdmission.budget.totalUsed)

  const calls = f.adapter.requests.length
  const replay = await reopenRecoverySessionFixture({
    root: f.root,
    workflowId: f.workflowId,
    modelScript: () => [],
  })
  t.after(() => replay.dispose())
  const replayOutcome = await replay.runtime.runCandidateIndependentReservation(replay.admissionAgent, replay.workflowId, 'T2:worker')
  assert.equal(replayOutcome.outcome, 'completed')
  assert.equal(replayOutcome.replay, true)
  assert.deepEqual(replayOutcome.result, outcome.result)
  assert.equal(f.adapter.requests.length, calls)
  assert.equal(replay.adapter.requests.length, 0)
  const replayed = await readRecoverySessionState(replay)
  assert.deepEqual(sourceFootprint(replayed), protectedBefore)
  assert.equal(await git(replayed.workflowWorktree, ['rev-parse', 'HEAD']), after.workflowHead)

})

test('T15 candidate pause keeps the source and budget unchanged when its independent Owner reports failed', { timeout: 45_000 }, async t => {
  const f = await notifiedCandidatePause(t, failedOwnerModel)
  const { before } = await reserveIndependentTask(f)
  const protectedBefore = sourceFootprint(before)
  const noticeBefore = pauseNotice(before)

  const outcome = await f.runtime.runCandidateIndependentReservation(f.admissionAgent, f.workflowId, 'T2:worker')
  assert.equal(outcome.outcome, 'failed')

  const after = await readRecoverySessionState(f)
  assert.deepEqual(sourceFootprint(after), protectedBefore)
  assert.deepEqual(pauseNotice(after), noticeBefore)
  const task = after.tasks.find(item => item.taskId === 'T2')
  const owner = after.ownerRuns['T2:worker']
  const settledReservation = after.supervisorOutbox['T2:worker']
  assert.equal(owner.status, 'failed')
  assert.equal(task.status, 'stopped')
  assert.equal(settledReservation.status, 'failed')
  assert.equal(after.recoveryAdmission.budget.totalUsed, before.recoveryAdmission.budget.totalUsed)

  const workflowHead = await git(after.workflowWorktree, ['rev-parse', 'HEAD'])
  const calls = f.adapter.requests.length
  const replayOutcome = await f.runtime.runCandidateIndependentReservation(f.admissionAgent, f.workflowId, 'T2:worker')
  assert.equal(replayOutcome.outcome, 'failed')
  assert.equal(replayOutcome.replay, true)
  assert.equal(replayOutcome.reason, outcome.reason)
  assert.equal(f.adapter.requests.length, calls)
  const replayed = await readRecoverySessionState(f)
  assert.deepEqual(sourceFootprint(replayed), protectedBefore)
  assert.equal(await git(replayed.workflowWorktree, ['rev-parse', 'HEAD']), workflowHead)
})

test('T15 candidate pause rejects a source change before finish without merging the independent Owner result', { timeout: 45_000 }, async t => {
  const f = await notifiedCandidatePause(t, completedOwnerModel)
  const { before } = await reserveIndependentTask(f)
  const noticeBefore = pauseNotice(before)
  const workflowHeadBefore = await git(before.workflowWorktree, ['rev-parse', 'HEAD'])
  const originalFinishOwner = f.runtime.finishOwner.bind(f.runtime)
  let changedSource = false
  f.runtime.finishOwner = async (...args) => {
    if (!changedSource) {
      changedSource = true
      await mutateRecoverySessionState(f, state => {
        state.pendingPlanRevision = { ...state.pendingPlanRevision, number: state.pendingPlanRevision.number + 1 }
      })
    }
    return originalFinishOwner(...args)
  }

  const outcome = await f.runtime.runCandidateIndependentReservation(f.admissionAgent, f.workflowId, 'T2:worker')
  assert.equal(changedSource, true)
  assert.equal(outcome.outcome, 'stale')

  const after = await readRecoverySessionState(f)
  assert.deepEqual(pauseNotice(after), noticeBefore)
  assert.equal(after.pendingPlanRevision.number, before.pendingPlanRevision.number + 1)
  assert.equal(after.workflowHead, before.workflowHead)
  assert.equal(await git(after.workflowWorktree, ['rev-parse', 'HEAD']), workflowHeadBefore)
  assert.equal(after.status, before.status)
  assert.equal(after.error, before.error)
  assert.deepEqual(after.recoveryAdmission, before.recoveryAdmission)
  const task = after.tasks.find(item => item.taskId === 'T2')
  const owner = after.ownerRuns['T2:worker']
  const settledReservation = after.supervisorOutbox['T2:worker']
  assert.notEqual(task.status, 'completed')
  assert.notEqual(owner?.status, 'completed')
  assert.equal(settledReservation.status, 'stopped')
})

test('T15 candidate pause rejects a source change before Owner submission without verification or a commit', { timeout: 45_000 }, async t => {
  const f = await notifiedCandidatePause(t, completedOwnerModel)
  const { before } = await reserveIndependentTask(f)
  const workflowHeadBefore = await git(before.workflowWorktree, ['rev-parse', 'HEAD'])
  const originalStream = f.adapter.stream.bind(f.adapter)
  let changedSource = false
  f.adapter.stream = async function* (options) {
    if (!changedSource && options.tools?.some(tool => tool.name === 'owner_submit')) {
      changedSource = true
      await mutateRecoverySessionState(f, state => {
        state.pendingPlanRevision = { ...state.pendingPlanRevision, number: state.pendingPlanRevision.number + 1 }
      })
    }
    yield* originalStream(options)
  }

  const outcome = await f.runtime.runCandidateIndependentReservation(f.admissionAgent, f.workflowId, 'T2:worker')
  assert.equal(changedSource, true)
  assert.equal(outcome.outcome, 'stale')

  const after = await readRecoverySessionState(f)
  assert.equal(after.pendingPlanRevision.number, before.pendingPlanRevision.number + 1)
  assert.equal(after.workflowHead, before.workflowHead)
  assert.equal(await git(after.workflowWorktree, ['rev-parse', 'HEAD']), workflowHeadBefore)
  assert.equal(after.status, before.status)
  assert.equal(after.error, before.error)
  assert.deepEqual(after.recoveryAdmission, before.recoveryAdmission)
  const task = after.tasks.find(item => item.taskId === 'T2')
  const owner = after.ownerRuns['T2:worker']
  const settledReservation = after.supervisorOutbox['T2:worker']
  assert.equal(task.verificationResults, undefined)
  assert.equal(owner?.verificationResults, undefined)
  assert.equal(owner?.result, undefined)
  assert.notEqual(task.status, 'completed')
  assert.notEqual(owner?.status, 'completed')
  assert.equal(settledReservation.status, 'stopped')
})

test('T15 candidate pause turns a real external permission gap into awaiting-user without charging recovery', { timeout: 45_000 }, async t => {
  const f = await notifiedCandidatePause(t, completedOwnerModel)
  const { before } = await reserveIndependentTask(f)
  const protectedBefore = sourceFootprint(before)
  const workflowHeadBefore = await git(before.workflowWorktree, ['rev-parse', 'HEAD'])
  const originalStream = f.adapter.stream.bind(f.adapter)
  let deviation
  f.adapter.stream = async function* (options) {
    if (deviation === undefined && options.tools?.some(tool => tool.name === 'owner_submit')) {
      const current = await readRecoverySessionState(f)
      const record = current.ownerRuns['T2:worker']
      deviation = await f.runtime.recordOwnerExecutionDeviation({
        expected: 'Read the remote ledger.',
        actual: 'Permission denied.',
        evidence: [{ kind: 'service_response', detail: 'Missing read:ledger permission.' }],
        technical_facts: ['The requested operation requires read:ledger.'],
        external_permission_gap: {
          required_permission: 'read:ledger', target: 'remote-ledger', blocked_action: 'Read the ledger.',
        },
      }, { agent: { id: record.sessionId } })
    }
    yield* originalStream(options)
  }

  const outcome = await f.runtime.runCandidateIndependentReservation(f.admissionAgent, f.workflowId, 'T2:worker')
  assert.ok(deviation)
  assert.equal(outcome.outcome, 'awaiting-user')

  const after = await readRecoverySessionState(f)
  assert.deepEqual(sourceFootprint(after), protectedBefore)
  assert.equal(await git(after.workflowWorktree, ['rev-parse', 'HEAD']), workflowHeadBefore)
  const task = after.tasks.find(item => item.taskId === 'T2')
  const owner = after.ownerRuns['T2:worker']
  const settledReservation = after.supervisorOutbox['T2:worker']
  const control = deriveWorkflowControl(after)
  assert.equal(task.action, 'await_user')
  assert.equal(owner.autonomousRecovery.strategy, 'request_user_authority')
  assert.equal(task.verificationResults, undefined)
  assert.equal(owner.result, undefined)
  assert.equal(settledReservation.status, 'stopped')
  assert.equal(control.phase, 'awaiting_main_discussion')
  assert.equal(control.actionRequired, true)
  assert.ok(Object.values(after.mainOutbox).some(item => item.reason === 'execution_authority_required'))
  assert.equal(after.recoveryAdmission.budget.totalUsed, before.recoveryAdmission.budget.totalUsed)
})
