+test('T15 persisted technical incident cannot hide a current typed user decision', async t => {
+  const f = await createRecoverySessionFixture(t, { executable: true, includeIndependentOwner: true })
+  await admitAuthorityFailure(f)
+  await f.runtime.recoverOwner(f.admissionAgent, f.workflowId, 'T1', 'api')
+  await mutateRecoverySessionState(f, s => {
+    const recovery = { contract: 'DSH_AUTONOMOUS_RECOVERY_V1', strategy: 'autonomous_incident', failureClass: 'transient' }
+    s.ownerRuns['T2:worker'] = { status: 'blocked', taskId: 'T2', ownerId: 'worker', attempt: 1,
+      sessionId: 'controlled-incident', autonomousRecovery: recovery }
+    Object.assign(s.tasks[1], { status: 'stopped', reason: 'runtime_failed', action: 'retry_runtime', autonomousRecovery: recovery })
+  })
+  const before = await readRecoverySessionState(f)
+  assert.equal(deriveWorkflowControl(before).phase, 'user_report_pending')
+  assert.equal(deriveWorkflowControl(before).actionRequired, true)
+  const next = await supervisorControl(f, 'supervisor-next')
+  assert.equal(next.action, 'notify')
+  const ack = await supervisorControl(f, 'supervisor-ack', { actionId: next.actionId })
+  const pending = await readRecoverySessionState(f)
+  for (const report of Object.values(pending.mainOutbox)) {
+    await supervisorControl(f, 'supervisor-outbox-ack', { notificationId: report.notificationId })
+  }
+  const after = await readRecoverySessionState(f)
+  assert.equal(deriveWorkflowControl(after).phase, 'waiting_workflow_decision')
+  assert.equal(deriveWorkflowControl(after).actionRequired, true)
+  assert.equal(deriveWorkflowControl(after).command, null)
+  assert.deepEqual(after.ownerRuns, before.ownerRuns)
+  assert.equal(f.adapter.requests.length, 0)
+  assert.ok(ack.notification.notificationId)
+  // A repeated notify projection cannot manufacture another pending report.
+  const repeated = await supervisorControl(f, 'supervisor-next')
+  const replay = await supervisorControl(f, 'supervisor-ack', { actionId: repeated.actionId })
+  assert.equal(replay.notification.notificationId, ack.notification.notificationId)
+  assert.equal(replay.notification.status, 'delivered')
+})
