import { createHash } from 'node:crypto'
import { readRecoverySessionArtifact } from './recovery-session.mjs'

export const REPLAN_SESSION_REQUEST_CONTRACT = 'DSH_REPLAN_SESSION_REQUEST_V1'
export const REPLAN_SESSION_STATE_CONTRACT = 'DSH_REPLAN_SESSION_STATE_V1'
export const REPLAN_SESSION_RESULT_CONTRACT = 'DSH_REPLAN_SESSION_RESULT_V1'
const PHASES = new Set(['creating', 'created', 'submitted', 'submission_observed', 'settled_failed', 'settled_cancelled'])

function exact(value, keys, name) {
  if (value === null || typeof value !== 'object' || Object.getPrototypeOf(value) !== Object.prototype
    || Object.getOwnPropertySymbols(value).length !== 0
    || Object.getOwnPropertyNames(value).length !== keys.length
    || keys.some(key => !Object.hasOwn(value, key))
    || Object.values(Object.getOwnPropertyDescriptors(value)).some(d => !d.enumerable || !Object.hasOwn(d, 'value'))) {
    throw new Error(`ReplanSession ${name}_invalid`)
  }
}
function text(value, name) {
  if (typeof value !== 'string' || value.trim() === '') throw new Error(`ReplanSession ${name}_invalid`)
  return value
}
function canonical(value) {
  if (Array.isArray(value)) return `[${value.map(canonical).join(',')}]`
  if (value !== null && typeof value === 'object') {
    return `{${Object.keys(value).sort().map(key => `${JSON.stringify(key)}:${canonical(value[key])}`).join(',')}}`
  }
  return JSON.stringify(value)
}
export function replanPayloadDigest(value) {
  return createHash('sha256').update(canonical(value)).digest('hex')
}
export function normalizeReplanSessionRequest(value) {
  exact(value, ['contract', 'requestId', 'prompt'], 'request')
  if (value.contract !== REPLAN_SESSION_REQUEST_CONTRACT) throw new Error('ReplanSession request_contract_invalid')
  exact(value.prompt, ['id', 'content'], 'prompt')
  return {
    contract: value.contract, requestId: text(value.requestId, 'request_id'),
    prompt: { id: text(value.prompt.id, 'prompt_id'), content: text(value.prompt.content, 'prompt_content') },
  }
}
function binding(intent, prompt) {
  if (intent.executionKind !== 'replan_operation' || intent.executionIdentity.promptId !== prompt.id) {
    throw new Error('ReplanSession reservation_binding_mismatch')
  }
  return {
    contract: REPLAN_SESSION_STATE_CONTRACT, sourceId: intent.sourceId,
    rootProblemId: intent.rootProblemId, requestId: intent.requestId, attemptId: intent.attemptId,
    planDigest: intent.planDigest, operationKind: intent.operationKind, operationId: intent.operationId,
    ordinal: intent.ordinal, executionIdentity: { ...intent.executionIdentity }, prompt: { ...prompt },
  }
}
export function createReplanSessionState(intent, prompt, leaseToken) {
  return { ...binding(intent, prompt), leaseToken: text(leaseToken, 'lease_token'), phase: 'creating', contextMessages: [] }
}
export function assertReplanSessionState(record, intent, prompt) {
  const expected = binding(intent, prompt)
  exact(record, [...Object.keys(expected), 'leaseToken', 'phase', 'contextMessages'], 'state')
  normalizeReplanContexts(record.contextMessages)
  if (record.contextMessages.some(message => message.id === prompt.id)) throw new Error('ReplanSession context_prompt_collision')
  if (!PHASES.has(record.phase)) throw new Error('ReplanSession state_phase_invalid')
  text(record.leaseToken, 'lease_token')
  for (const key of Object.keys(expected)) {
    if (canonical(record[key]) !== canonical(expected[key])) throw new Error('ReplanSession state_binding_mismatch')
  }
}
// Captured by the actual provider pre-step boundary before the model sees the
// snapshot. Matching a plugin name in a log alone never grants this allowance.
export function normalizeReplanContexts(messages) {
  if (!Array.isArray(messages)) throw new Error('ReplanSession contexts_invalid')
  const ids = new Set()
  return messages.map(message => {
    exact(message, ['id', 'role', 'content', 'source'], 'context_message')
    text(message.id, 'context_id')
    if (ids.has(message.id) || message.role !== 'user' || !Array.isArray(message.content)
      || message.content.length !== 1 || message.content[0]?.type !== 'text'
      || typeof message.content[0].text !== 'string') throw new Error('ReplanSession context_message_invalid')
    ids.add(message.id)
    const source = message.source
    exact(source, source?.form === 'snapshot' ? ['kind', 'plugin', 'form', 'sections'] : ['kind', 'plugin'], 'context_source')
    if (source.kind !== 'plugin' || source.plugin !== '@deepseek-ai/dsh-system-prompt') throw new Error('ReplanSession context_source_invalid')
    if (source.form === 'snapshot') {
      if (!Array.isArray(source.sections)) throw new Error('ReplanSession context_sections_invalid')
      for (const section of source.sections) {
        exact(section, ['name', 'text'], 'context_section')
        text(section.name, 'context_section_name')
        text(section.text, 'context_section_text')
      }
    }
    return structuredClone(message)
  })
}

export function assertReplanSessionAttempt(record, intent, attempt) {
  if (record.phase === 'creating') {
    if (attempt?.state !== 'reserved') throw new Error('ReplanSession creating_attempt_mismatch')
    return
  }
  const status = record.phase === 'settled_failed' ? 'failed' : record.phase === 'settled_cancelled' ? 'cancelled' : undefined
  if (attempt?.state !== (status === undefined ? 'running' : 'settled')
    || canonical(attempt.executionRef) !== canonical({ id: intent.executionIdentity.sessionId, version: intent.executionIdentity.promptId })
    || (status !== undefined && (attempt.result?.status !== status
      || canonical(attempt.result.reference) !== canonical({ id: intent.executionIdentity.promptId, version: intent.executionIdentity.sessionId })))) {
    throw new Error('ReplanSession execution_receipt_mismatch')
  }
}

export function replanBudgetBinding(workflowId, intent) {
  return {
    workflowId, rootProblemId: intent.rootProblemId, requestId: intent.requestId,
    attemptId: intent.attemptId, executionVersion: intent.planDigest,
    executionKind: 'replan_operation', operationKind: intent.operationKind, operationId: intent.operationId,
  }
}
const pause = (reason, extra = {}) => ({ outcome: 'paused', phase: 'technical_pause', reason, ...extra })

function replanTurnFacts(events, prompt, contextMessages) {
  const matches = value => value?.id === prompt.id && value?.role === 'user'
    && canonical(value.content) === canonical([{ type: 'text', text: prompt.content }])
    && canonical(value.source) === canonical({ kind: 'user' })
  const inputs = events.filter(event => event.type === 'user/message').map(event => event.data)
  const queued = events.filter(event => event.type === 'agent/inbox/spliced')
    .flatMap(event => (event.data?.inserted ?? []).filter(item => item?.role === 'user'))
  const contexts = normalizeReplanContexts(contextMessages)
  const extras = inputs.filter(item => !matches(item))
  if (extras.some(item => !contexts.some(saved => canonical(saved) === canonical(item)))
    || queued.some(item => !matches(item))) return pause('extra_or_wrong_input')
  if (new Set(inputs.map(item => item.id)).size !== inputs.length
    || inputs.filter(matches).length !== 1 || queued.length > 1) return pause('prompt_not_unique')
  const turns = events.filter(event => event.type === 'turn/start')
  const ends = events.filter(event => event.type === 'turn/end')
  if (turns.length !== 1 || !Number.isSafeInteger(turns[0].data?.turn)) return pause('prompt_turn_ambiguous')
  const turn = turns[0].data.turn
  if (ends.length === 0) return pause('session_not_terminal')
  if (ends.length !== 1 || ends[0].data?.turn !== turn) return pause('terminal_shape_ambiguous')
  const starts = events.filter(event => event.type === 'step/start')
  const stepEnds = events.filter(event => event.type === 'step/end')
  const assistants = events.filter(event => event.type === 'assistant/message')
  if (starts.length === 0 || starts.length !== stepEnds.length || starts.length !== assistants.length) {
    return pause('terminal_step_ambiguous')
  }
  const steps = new Set()
  for (const start of starts) {
    const step = start.data?.step
    const end = stepEnds.filter(event => event.data?.turn === turn && event.data?.step === step)
    const message = assistants.filter(event => event.data?.turn === turn && event.data?.step === step)
    if (start.data?.turn !== turn || !Number.isSafeInteger(step) || steps.has(step)
      || end.length !== 1 || message.length !== 1 || start.seq >= end[0].seq
      || end[0].seq >= ends[0].seq || message[0].seq <= start.seq || message[0].seq >= end[0].seq) {
      return pause('terminal_step_ambiguous')
    }
    steps.add(step)
  }
  return { outcome: 'observed_terminal', turn, steps: [...steps], terminalSeq: ends[0].seq }
}

/** Accepted tool output is submission evidence, never evidence that a DAG was applied. */
export async function inspectReplanSession({ persistence, intent, prompt, contextMessages = [], signal }) {
  const observation = await readRecoverySessionArtifact({ persistence, executionIdentity: intent.executionIdentity, prompt, signal })
  if (observation.outcome !== 'artifact') return pause(observation.reason ?? 'artifact_unavailable')
  const { events } = observation
  const facts = { ...replanTurnFacts(events, prompt, contextMessages), revision: observation.revision }
  if (facts.outcome !== 'observed_terminal') return facts
  const terminal = events.find(event => event.seq === facts.terminalSeq)
  const endKind = terminal?.data?.reason?.kind ?? terminal?.data?.kind
  if (!['completed', 'aborted'].includes(endKind)) return pause('terminal_reason_unknown')
  const review = intent.operationKind === 'revision_review'
  const toolName = review ? 'workflow_plan_review_submit' : 'workflow_plan_submit'
  const receiptContract = review ? 'DSH_WORKFLOW_PLAN_REVIEW_SUBMIT_RESULT_V1' : 'DSH_WORKFLOW_PLAN_SUBMIT_RESULT_V1'
  const calls = events.filter(event => event.type === 'tool/call' && event.data?.name === toolName)
  const accepted = []
  for (const call of calls) {
    if (call.data.turn !== facts.turn || !facts.steps.includes(call.data.step)) return pause('tool_turn_mismatch')
    const results = events.filter(event => event.type === 'tool/result'
      && event.data?.message?.source?.callId === call.data.callId)
    if (results.length !== 1) return pause('tool_result_unknown')
    const result = results[0]
    const message = result.data.message
    if (result.seq <= call.seq || result.seq >= facts.terminalSeq
      || canonical(result.sourceEventSeqs) !== canonical([call.seq])
      || result.data.turn !== facts.turn || result.data.step !== call.data.step
      || message.role !== 'user' || message.source.kind !== 'tool'
      || !Array.isArray(message.content) || message.content.length !== 1) return pause('tool_result_binding_mismatch')
    const block = message.content[0]
    if (block?.type !== 'tool-result' || block.toolCallId !== call.data.callId) return pause('tool_result_binding_mismatch')
    if (result.data.error !== undefined || block.isError === true) continue
    if (block.isError !== false || !Array.isArray(block.content)
      || block.content.some(item => item?.type !== 'text' || typeof item.text !== 'string')) return pause('tool_result_invalid')
    let receipt, args
    try {
      receipt = JSON.parse(block.content.map(item => item.text).join(''))
      args = JSON.parse(call.data.arguments)
    } catch { return pause('tool_payload_invalid') }
    if (receipt?.contract !== receiptContract || receipt.accepted !== true) return pause('tool_not_accepted')
    const payload = args?.[review ? 'review' : 'plan']
    if (payload === null || typeof payload !== 'object' || Array.isArray(payload)) return pause('tool_payload_invalid')
    accepted.push({
      payload,
      receipt: { toolName, callId: call.data.callId, callSeq: call.seq, resultSeq: result.seq,
        payloadDigest: replanPayloadDigest(payload), terminalSeq: facts.terminalSeq, terminalKind: endKind, revision: facts.revision },
    })
  }
  if (accepted.length > 1) return pause('submission_not_unique')
  if (accepted.length === 1) return { outcome: 'submission_observed', phase: 'submission_observed', ...accepted[0] }
  return {
    outcome: endKind === 'aborted' ? 'cancelled' : 'failed',
    phase: endKind === 'aborted' ? 'settled_cancelled' : 'settled_failed',
    reason: 'submission_missing', observation: facts,
  }
}
