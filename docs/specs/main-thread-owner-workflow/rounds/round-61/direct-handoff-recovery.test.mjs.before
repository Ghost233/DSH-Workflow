import assert from 'node:assert/strict'
import test from 'node:test'
import { requestHandoffDefinition, plannerSubmitDefinition } from '../index.js'
import { deriveWorkflowControl } from '../src/workflow-state.mjs'
import { createRecoverySessionFixture, readRecoverySessionState, mutateRecoverySessionState } from './fixtures/recovery-session-fixture.mjs'

for (const { paid, repeatReport, authority } of [{ paid: false }, { paid: true }, { paid: true, repeatReport: true }, { paid: false, authority: true }]) test(`T15 real request_handoff preserves its ${paid ? 'paid' : 'initial free'} Owner${repeatReport ? ' with repeated handoff in report' : ''}${authority ? ' with a real user permission gap' : ''} until terminal and ${authority ? 'returns the permission decision' : 'stages a metered candidate'}`, { timeout: 30_000 }, async t => {
  let f, proposal, payload, atStart, afterRequest
  const handoff = { targetType: 'owner', targetOwnerId: 'worker', summary: 'Existing worker must handle its file.',
    reason: 'The file belongs to worker scope.', files: ['src/worker/independent.mjs'] }
  f = await createRecoverySessionFixture(t, { executable: true, includeIndependentOwner: true,
    limits: { totalLimit: 4, problemLimit: 3 }, modelScript: m => [
      () => m.toolCallResponse('direct-request', 'request_handoff', { workflow_id: f.workflowId, task_id: 'T1',
        handoff, delta: { plan: proposal, invalidate: ['T2'] } }),
      m.toolCallResponse('direct-blocked', 'owner_submit', { report: {
        contract: 'DSH_OWNER_RESULT_V1', status: 'blocked', summary: 'Technical transfer recorded for the existing worker.',
        changes: [], tests: [], handoffs: repeatReport ? [handoff] : [], memory_updates: [],
      } }),
      m.textResponse('reported'),
      () => m.toolCallResponse('direct-planned', 'workflow_plan_submit', { plan: payload }), 'hang-slow',
    ] })
  f.ctx.tools.register(requestHandoffDefinition(f.runtime))
  f.ctx.tools.register(plannerSubmitDefinition(f.runtime))
  if (!paid) await mutateRecoverySessionState(f, state => { delete state.ownerRuns['T1:api'] })
  const initial = await readRecoverySessionState(f)
  proposal = { ...structuredClone(initial.plan), summary: 'Proposed transfer must remain a proposal' }
  payload = { ...structuredClone(initial.plan), summary: 'Independent Planner candidate', owners: initial.plan.owners.map(owner => ({ id: owner.id })) }
  const stream = f.adapter.stream.bind(f.adapter)
  let index = 0
  f.adapter.stream = async function* (options) {
    const current = index++
    if (current === 0) atStart = await readRecoverySessionState(f)
    if (current === 1) {
      afterRequest = await readRecoverySessionState(f)
      assert.equal(afterRequest.planDigest, initial.planDigest)
      assert.deepEqual(afterRequest.plan, initial.plan)
      assert.equal(afterRequest.planApproved, true)
      assert.equal(afterRequest.planReviewDigest, initial.planDigest)
      assert.equal(afterRequest.status, 'running')
      const record = afterRequest.ownerRuns['T1:api']
      assert.equal(record.status, 'running')
      assert.equal(record.attempt, atStart.ownerRuns['T1:api'].attempt)
      assert.equal(record.sessionId, atStart.ownerRuns['T1:api'].sessionId)
      assert.equal(record.leaseToken, atStart.ownerRuns['T1:api'].leaseToken)
      assert.deepEqual(afterRequest.tasks, atStart.tasks)
      assert.deepEqual(afterRequest.supervisorOutbox, atStart.supervisorOutbox)
      assert.equal(afterRequest.handoffQueue.length, 1)
      assert.equal(afterRequest.handoffQueue[0].proposal.plan.summary, proposal.summary)
      assert.equal(afterRequest.handoffQueue[0].proposal.basePlanDigest, initial.planDigest)
      assert.equal(deriveWorkflowControl(afterRequest).phase, 'handoff_source_running')
      const used = afterRequest.recoveryAdmission?.budget.totalUsed ?? 0
      await assert.rejects(f.runtime.replanHandoffs(f.admissionAgent, f.workflowId), /owner_failure_task_running/)
      const stillRunning = await readRecoverySessionState(f)
      assert.equal(stillRunning.recoveryAdmission?.budget.totalUsed ?? 0, used)
      assert.equal(stillRunning.handoffReplans, undefined)
      if (authority) await f.runtime.recordOwnerExecutionDeviation({
        expected: 'Read a remote ledger', actual: 'Permission denied',
        evidence: [{ kind: 'service_response', detail: 'Missing read:ledger scope' }],
        technical_facts: ['Current operation requires read:ledger'],
        external_permission_gap: { required_permission: 'read:ledger', target: 'remote-ledger', blocked_action: 'Read ledger' },
      }, { agent: { id: record.sessionId } })
    }
    yield* stream(options)
  }
  const run = paid
    ? f.runtime.recoverOwner(f.admissionAgent, f.workflowId, 'T1', 'api')
    : f.runtime.runExternalOwner(f.admissionAgent, f.workflowId, 'T1', 'api')
  await assert.rejects(run, { name: repeatReport ? 'OwnerHandoffError' : 'OwnerReportedError' })
  assert.ok(afterRequest, 'actual request_handoff must have returned to the Owner model')
  const terminal = await readRecoverySessionState(f)
  const record = terminal.ownerRuns['T1:api']
  assert.equal(record.status, 'blocked')
  if (authority) {
    assert.equal(terminal.tasks[0].action, 'await_user')
    assert.equal(record.autonomousRecovery.strategy, 'request_user_authority')
    const calls = f.adapter.requests.length
    await assert.rejects(f.runtime.replanHandoffs(f.admissionAgent, f.workflowId), /用户决定/)
    assert.equal(f.adapter.requests.length, calls)
    assert.equal(terminal.recoveryAdmission, undefined)
    assert.ok(Object.values(terminal.mainOutbox).some(item => item.reason === 'execution_authority_required'))
    return
  }
  assert.notEqual(terminal.tasks[0].action, 'await_user')
  assert.equal(deriveWorkflowControl(terminal).command, 'handoff-replan')
  assert.equal(record.sessionId, afterRequest.ownerRuns['T1:api'].sessionId)
  const raw = await f.readRaw(record.sessionId)
  assert.ok(raw.content.includes('direct-request'))
  const events = (await f.readFrom(record.sessionId)).events
  const requestCall = events.find(event => event.type === 'tool/call' && event.data.name === 'request_handoff')
  const terminalEvent = events.find(event => event.type === 'turn/end')
  assert.ok(requestCall && terminalEvent && terminalEvent.seq > requestCall.seq)
  assert.equal(terminalEvent.data.reason.kind, 'completed')
  if (paid) {
    assert.equal(terminal.recoveryAdmission.budget.totalUsed, 1)
    assert.equal(record.recoverySession.phase, 'settled_failed')
    assert.ok(record.recoveryContinuation)
  }
  const result = await f.runtime.replanHandoffs(f.admissionAgent, f.workflowId)
  assert.equal(result.contract, 'DSH_PLAN_REVISION_CANDIDATE_V1')
  const saved = await readRecoverySessionState(f)
  assert.equal(saved.recoveryAdmission.budget.totalUsed, paid ? 2 : 1)
  assert.equal(saved.recoveryAdmission.budget.problems.length, 1)
  assert.equal(saved.pendingPlanRevision.plan.summary, payload.summary)
  assert.equal(saved.planDigest, initial.planDigest)
  assert.deepEqual(saved.plan, initial.plan)
  assert.deepEqual(saved.ownerRuns, terminal.ownerRuns)
  const plannerRequest = f.adapter.requests.find(options => JSON.stringify(options).includes('未应用提案'))
  assert.ok(plannerRequest, 'actual Planner sees proposal status in its prompt')
})
