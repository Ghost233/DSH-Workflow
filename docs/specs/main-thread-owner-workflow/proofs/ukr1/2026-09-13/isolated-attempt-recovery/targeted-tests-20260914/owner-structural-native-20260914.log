ray","items":{"type":"object","additionalProperties":false,"properties":{"id":{"type":"string","minLength":1,"pattern":"^[A-Za-z][A-Za-z0-9_-]{0,63}$","description":"Stable task id."},"title":{"type":"string","minLength":1,"description":"Human-readable task title."},"role":{"type":"string","enum":["work","review","verify"]},"ownerId":{"type":"string","minLength":1,"pattern":"^[a-z][a-z0-9_-]{0,63}$","description":"Exactly one existing Owner Registry id."},"write":{"type":"array","items":{"type":"string","minLength":1,"pattern":"^(?![/\\\\])(?!\\.\\.?$)(?!\\.\\.(?:[/\\\\]|$))(?!.*[/\\\\]\\.\\.(?:[/\\\\]|$)).+$","description":"Repository-relative write glob; it must be inside the selected Owner scope.","maxLength":256},"description":"Allowed source paths; review and verify tasks may omit this field or use an empty array."},"dependsOn":{"type":"array","items":{"type":"string","minLength":1,"pattern":"^[A-Za-z][A-Za-z0-9_-]{0,63}$","description":"Predecessor task id."},"description":"Task ids whose integrated results are required first."},"resources":{"type":"array","items":{"type":"string","minLength":1,"pattern":"^[A-Za-z][A-Za-z0-9._+:/@-]{0,255}$","description":"Exclusive resource/lock identity such as db:test or tcp:localhost:3080; prose belongs in done."},"uniqueItems":true,"description":"Optional exclusive resource identities; these are lock tokens, not requirements or Ticket text."},"verify":{"type":"array","items":{"type":"string","minLength":1,"pattern":"^[a-z][a-z0-9_-]{0,63}$","description":"Verification id declared in plan.verifications; never put a command here."},"description":"Verification references. Every executable leaf work task needs at least one."},"done":{"type":"array","items":{"type":"string","minLength":1,"description":"Observable completion condition."},"minItems":1},"priority":{"type":"integer","minimum":0,"maximum":10000},"parentTaskId":{"type":"string","minLength":1,"pattern":"^[A-Za-z][A-Za-z0-9_-]{0,63}$","description":"Composite parent t