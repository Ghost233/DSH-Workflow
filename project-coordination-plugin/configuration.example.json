{
  "schema": 1,
  "pollMs": 60000,
  "ghExecutable": "/absolute/path/to/gh",
  "limits": { "maxMembers": 16, "maxDepth": 8, "maxRunning": 4 },
  "members": [
    { "bot": "boss", "role": "principal" },
    { "bot": "repo-owner", "role": "manager", "repository": "YOUR-OWNER/YOUR-REPO", "parent": "boss" },
    { "bot": "developer", "role": "executor", "repository": "YOUR-OWNER/YOUR-REPO", "parent": "repo-owner" }
  ],
  "repositories": [
    {
      "repository": "YOUR-OWNER/YOUR-REPO",
      "manager": "repo-owner",
      "allowedActors": ["YOUR-GITHUB-LOGIN"],
      "githubActor": "YOUR-GITHUB-LOGIN",
      "ghConfigDir": "/absolute/path/to/gh-profiles/YOUR-GITHUB-LOGIN",
      "checkout": "/absolute/path/to/existing/repository",
      "executionRoot": "/absolute/path/to/authorized/worktrees",
      "baseRef": "origin/main",
      "baseBranch": "main",
      "verificationCommands": [["./YOUR-PROJECT-CHECK-SCRIPT"]]
    }
  ],
  "templates": [
    {
      "name": "frontend",
      "role": "executor",
      "modelPreset": "REPLACE-WITH-AN-APPROVED-TOBS-PRESET-ID",
      "persona": "Implement assigned frontend work. Accept or return tasks with a reason. Use project_work for verification and structured reporting."
    }
  ]
}
